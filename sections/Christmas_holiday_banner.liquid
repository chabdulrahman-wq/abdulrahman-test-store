<style>
    .Christmas_hoilday_banner_section {
    position: relative;
    height: 945px;
    width: 100%;
    overflow-x: hidden;
    overflow-y: hidden;
}

.Christmas_hoilday_banner_desktop_img {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    object-fit: cover;
    object-position: left top;
}

.Christmas_hoilday_banner_Slider_flex {
    display: flex;
    align-items: flex-end;
    height: 100%;
    overflow-y: hidden;
}

.Christmas_hoilday_banner_main_Slider_box {
    overflow-x: hidden;
    margin-bottom: 100px;
}

.Christmas_hoilday_banner_main_Slider_title_desktop {
    color: white;
    text-align: center;
    font-size: 40px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 130px;
}
.Christmas_hoilday_banner_main_Slider_title_mobile {
    color: white;
    text-align: center;
    font-size: 40px;
    position: absolute;
    display: none;
    left: 50%;
    transform: translateX(-50%);
    top: 130px;
}

.Christmas_hoilday_banner_main_Slider_inner {
    padding-bottom: 70px;
    padding-top: 0px;
    padding-left: 380px;
}

.Christmas_hoilday_banner_main_Slider_wrapper {
    position: relative;
    overflow: hidden;
}

.Christmas_hoilday_banner_main_Slider_Slick{
    display: flex;
    justify-content: space-between;
    position: relative;
    margin-bottom: 30px;
}

.Christmas_hoilday_banner_main_Slider_Slick_item {
    margin: 0 20px;
    box-sizing: border-box;
}
</style>

<section class="Christmas_hoilday_banner_section">
  <div class="Christmas_hoilday_banner_Images">
    {% if section.settings['main-Christmas_hoilday_banner_desktop_img'] != blank %}
      <img
        class="Christmas_hoilday_banner_desktop_img"
        src="{{ section.settings.main-Christmas_hoilday_banner_desktop_img |img_url:'master' }}"
      >
    {% endif %}
  </div>
  <div class="Christmas_hoilday_banner_Slider_flex">
    <div class="Christmas_hoilday_banner_main_Slider_box">
      <h1 class="Christmas_hoilday_banner_main_Slider_title_desktop">
        {{ section.settings['mian-Christmas_hoilday_banner_main_Slider_title_desktop'] }}
      </h1>
      <h1 class="Christmas_hoilday_banner_main_Slider_title_mobile">
        {{ section.settings['mian-Christmas_hoilday_banner_main_Slider_title_mobile'] }}
      </h1>
      <div class="Christmas_hoilday_banner_main_Slider_inner">
        <div class="Christmas_hoilday_banner_main_Slider_wrapper">
          <div class="Christmas_hoilday_banner_main_Slider_Slick">
            {% for block in section.blocks %}
              {% assign products_product = block.settings.products_list %}
              {% if products_product != blank %}
                {% for products in products_product %}
                  <div class="Christmas_hoilday_banner_main_Slider_Slick_item">
                    <div class="Christmas_hoilday_banner_main_Slider_product_flex">
                      <div class="Christmas_hoilday_banner_main_Slider_product_box">
                        <div class="Christmas_hoilday_banner_main_Slider_product_images">
                          {% if block.settings['main-Christmas_hoilday_banner_main_Slider_badge_image'] != blank %}
                            <img
                              class="Christmas_hoilday_banner_main_Slider_badge_image"
                              src="{{ block.settings.main-Christmas_hoilday_banner_main_Slider_badge_image |img_url:'master' }}"
                            >
                          {% endif %}
                          <a href="{{ products.url }}" class="Christmas_hoilday_banner_main_Slider_product_images_Link">
                            <img
                              class="Christmas_hoilday_banner_main_Slider_product_images_Img"
                              src="{{ products.featured_image | img_url: 'master' }}"
                              alt="{{ products.title }}"
                            >
                          </a>
                          <div class="Christmas_hoilday_banner_main_Slider_product_Title">
                            <h4 class="Christmas_hoilday_banner_main_Slider_product_Title_text">
                              <a
                                href="{{ products.url }}"
                                class="Christmas_hoilday_banner_main_Slider_product_Title_link"
                              >
                                {{ products.title }}
                              </a>
                            </h4>
                          </div>
                          <div class="Christmas_hoilday_banner_main_Slider_product_price">
                            <span class="Christmas_hoilday_banner_main_Slider_product_price_span">
                              {{ products.price | money }}
                            </span>
                            {% if products.compare_at_price > products.price %}
                              <span class="Christmas_hoilday_banner_main_Slider_product_compare_price_span">
                                {{ products.compare_at_price | money }}
                              </span>
                            {% endif %}
                          </div>
                          <div class="Christmas_hoilday_banner_main_Slider_product_Button_Add_to">
                            {%- render 'new-buy-buttons',
                              block: block,
                              product: products,
                              product_form_id: product_form_id,
                              section_id: section.id,
                              show_pickup_availability: true
                            -%}
                          </div>
                          <div class="Christmas_hoilday_banner_main_Slider_product_description">
                            <p>
                                {{ products.description | strip_html }}
                            </p>
                            </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    $('.Christmas_hoilday_banner_main_Slider_wrapper').slick({
      slidesToShow: 3,
      slidesToScroll: 1,
      arrows: true,
      dots: true,
      infinite: true,
      speed: 600,
      autoplay: true,
      autoplaySpeed: 4000,
      prevArrow: '<button class="slick-prev">‹</button>',
      nextArrow: '<button class="slick-next">›</button>',
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2
          }
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1
          }
        }
      ]
    });
  });
</script>
{% schema %}
{
  "name": "Christmas Holiday Banner",
  "settings": [
    {
    "type": "image_picker",
    "id": "main-Christmas_hoilday_banner_desktop_img",
    "label": "Main Desktop Images"
    },
    {
    "type": "text",
    "id": "mian-Christmas_hoilday_banner_main_Slider_title_desktop",
    "label": "Main Title Desktop"
    },
    {
    "type": "textarea",
    "id": "mian-Christmas_hoilday_banner_main_Slider_title_mobile",
    "label": "Main Title Mobile"
    }
  ],
  "blocks": [
    {
    "type": "Product",
    "name": "Product",
    "settings": [
        {
        "type": "image_picker",
        "id": "main-Christmas_hoilday_banner_main_Slider_badge_image",
        "label": "Product Top images"
        },
        {
        "type": "product_list",
        "id": "products_list",
        "label": "Products List"
        }
    ]
    }
  ],
  "presets": [
    {
    "name": "Christmas Holiday Banner"
    }
  ]
}
{% endschema %}
