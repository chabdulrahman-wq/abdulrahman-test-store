<style>
.Christmas_hoilday_banner_section {
  position: relative;
  width: 100%;
  height: 945px;
  overflow: hidden;
}

.Christmas_hoilday_banner_desktop_img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.Christmas_hoilday_banner_main_Slider_box {
  position: relative;
  z-index: 2;
}

.Christmas_hoilday_banner_main_Slider_title_desktop {
  color: #fff;
  text-align: center;
  font-size: 40px;
  margin-top: 130px;
}

.Christmas_hoilday_banner_main_Slider_title_mobile {
  display: none;
  color: #fff;
  text-align: center;
  font-size: 32px;
  margin-bottom: 20px;
}

.Christmas_hoilday_banner_main_Slider_inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 60px 40px 0;
}

.Christmas_hoilday_banner_main_Slider_Slick_item {
  padding: 0 12px;
}

.Christmas_hoilday_banner_main_Slider_product_flex {
  background: rgba(0,0,0,0.25);
  border-radius: 20px;
  padding: 20px;
  text-align: center;
}

.Christmas_hoilday_banner_main_Slider_product_images_Img {
  max-width: 220px;
  height: 220px;
  object-fit: contain;
  margin: 0 auto;
}

.Christmas_hoilday_banner_main_Slider_product_Title_text a {
  color: #fff;
  text-decoration: none;
  font-size: 16px;
}

.Christmas_hoilday_banner_main_Slider_product_price_span {
  color: #fff;
}

.slick-prev,
.slick-next {
  z-index: 5;
}

@media (max-width: 768px) {
  .Christmas_hoilday_banner_section {
    height: auto;
    padding: 60px 0;
  }

  .Christmas_hoilday_banner_main_Slider_title_desktop {
    display: none;
  }

  .Christmas_hoilday_banner_main_Slider_title_mobile {
    display: block;
  }

  .Christmas_hoilday_banner_main_Slider_inner {
    padding: 0 20px;
  }
}
</style>

<section class="Christmas_hoilday_banner_section">
  {% if section.settings.main-Christmas_hoilday_banner_desktop_img != blank %}
    <img class="Christmas_hoilday_banner_desktop_img"
      src="{{ section.settings.main-Christmas_hoilday_banner_desktop_img | img_url: 'master' }}">
  {% endif %}

  <div class="Christmas_hoilday_banner_main_Slider_box">
    <h1 class="Christmas_hoilday_banner_main_Slider_title_desktop">
      {{ section.settings.mian-Christmas_hoilday_banner_main_Slider_title_desktop }}
    </h1>

    <h1 class="Christmas_hoilday_banner_main_Slider_title_mobile">
      {{ section.settings.mian-Christmas_hoilday_banner_main_Slider_title_mobile }}
    </h1>

    <div class="Christmas_hoilday_banner_main_Slider_inner">
      <div class="Christmas_hoilday_banner_main_Slider_Slick">
        {% for block in section.blocks %}
          {% for product in block.settings.products_list %}
            <div class="Christmas_hoilday_banner_main_Slider_Slick_item">
              <div class="Christmas_hoilday_banner_main_Slider_product_flex">

                <a href="{{ product.url }}">
                  <img class="Christmas_hoilday_banner_main_Slider_product_images_Img"
                    src="{{ product.featured_image | img_url: 'medium' }}">
                </a>

                <h4 class="Christmas_hoilday_banner_main_Slider_product_Title_text">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h4>

                <div class="Christmas_hoilday_banner_main_Slider_product_price">
                  <span class="Christmas_hoilday_banner_main_Slider_product_price_span">
                    {{ product.price | money }}
                  </span>
                </div>

                {% render 'new-buy-buttons',
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id
                %}

              </div>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
  $('.Christmas_hoilday_banner_main_Slider_Slick').slick({
    slidesToShow: 3,
    slidesToScroll: 1,
    dots: true,
    arrows: true,
    autoplay: true,
    autoplaySpeed: 4000,
    infinite: true,
    responsive: [
      { breakpoint: 1024, settings: { slidesToShow: 2 }},
      { breakpoint: 768, settings: { slidesToShow: 1, arrows: false }}
    ]
  });
});
</script>

{% schema %}
{
  "name": "Christmas Holiday Slick",
  "settings": [
    {
      "type": "image_picker",
      "id": "main-Christmas_hoilday_banner_desktop_img",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "mian-Christmas_hoilday_banner_main_Slider_title_desktop",
      "label": "Desktop Title"
    },
    {
      "type": "text",
      "id": "mian-Christmas_hoilday_banner_main_Slider_title_mobile",
      "label": "Mobile Title"
    }
  ],
  "blocks": [
    {
      "type": "products",
      "name": "Products",
      "settings": [
        {
          "type": "product_list",
          "id": "products_list",
          "label": "Select Products"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Christmas Holiday Slick Slider"
    }
  ]
}
{% endschema %}
