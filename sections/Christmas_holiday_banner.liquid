<style>
      .Christmas_hoilday_banner_section {
      position: relative;
      height: 945px;
      width: 100%;
      overflow-x: hidden;
      overflow-y: hidden;
  }

  .Christmas_hoilday_banner_desktop_img {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      right: 0;
      object-fit: cover;
      object-position: left top;
  }

  .Christmas_hoilday_banner_Slider_flex {
      display: flex;
      align-items: flex-end;
      height: 100%;
      overflow-y: hidden;
  }

  .Christmas_hoilday_banner_main_Slider_box {
      overflow-x: hidden;
      margin-bottom: 100px;
  }

  .Christmas_hoilday_banner_main_Slider_title_desktop {
      color: white;
      text-align: center;
      font-size: 40px;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      top: 130px;
  }
  .Christmas_hoilday_banner_main_Slider_title_mobile {
      color: white;
      text-align: center;
      font-size: 40px;
      position: absolute;
      display: none;
      left: 50%;
      transform: translateX(-50%);
      top: 130px;
  }

  .Christmas_hoilday_banner_main_Slider_inner {
      padding-bottom: 70px;
      padding-top: 0px;
      padding-left: 380px;
  }

  .Christmas_hoilday_banner_main_Slider_wrapper {
      position: relative;
      overflow: hidden;
  }

  .Christmas_hoilday_banner_main_Slider_Slick{
      display: flex;
      justify-content: space-between;
      position: relative;
      margin-bottom: 30px;
  }

  .Christmas_hoilday_banner_main_Slider_Slick_item {
      margin: 0 20px;
      box-sizing: border-box;
  }

  .Christmas_hoilday_banner_main_Slider_product_flex {
      padding: 16px !important;
      border-radius: 20px;
      transition: all 350ms ease-in-out;
      margin-right: 15px;
  }

  .Christmas_hoilday_banner_main_Slider_badge_image {
      position: relative;
      width: 70px;
      right: -154px;
      max-width: 70px;
      height: 70px;
      top: 111px;
      object-fit: contain;
  }

  .Christmas_hoilday_banner_main_Slider_product_images_Img {
      max-width: 260px;
      width: 341px;
      height: 241px;
      object-fit: contain;
      margin: 0 auto;
  }

  .Christmas_hoilday_banner_main_Slider_product_Title_text {
      color: white;
      font-size: 17px;
      text-align: center;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      padding: 25px 10px 0;
      padding-top: 15px;
      max-width: 90%;
      margin: 0 auto;
  }

  .Christmas_hoilday_banner_main_Slider_product_Title_link {
      color: white;
      text-decoration: none;
  }

  .Christmas_hoilday_banner_main_Slider_product_price {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 10px 0 8px;
  }

  .Christmas_hoilday_banner_main_Slider_product_price_span {
      color: white;
      font-size: 16px;
  }

  .Christmas_hoilday_banner_main_Slider_product_compare_price_span {
      color: white;
      font-size: 14px;
      text-decoration: line-through;
  }

  .Christmas_hoilday_banner_main_Slider_product_description p {
      color: white;
      font-size: 12px;
      line-height: normal !important;
      text-align: center;
      padding-top: 10px;
      padding-bottom: 15px;
  }

  /* Slick Dots */
  .Christmas_hoilday_banner_main_Slider_Slick .slick-dots {
      bottom: 20px;
      display: flex !important;
      justify-content: center;
      gap: 12px;
  }

  .Christmas_hoilday_banner_main_Slider_Slick .slick-dots li {
      width: 12px;
      height: 12px;
      margin: 0;
  }

  .Christmas_hoilday_banner_main_Slider_Slick .slick-dots li button {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: white;
      opacity: 1;
      padding: 0;
  }

  .Christmas_hoilday_banner_main_Slider_Slick .slick-dots li.slick-active button {
      background: #a0ff00; /* green active dot */
  }

  /* Slick Arrows */
  .Christmas_hoilday_banner_main_Slider_Slick .slick-prev,
  .Christmas_hoilday_banner_main_Slider_Slick .slick-next {
      width: 40px;
      height: 40px;
      z-index: 2;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(0,0,0,0.5);
      border-radius: 50%;
      display: flex !important;
      justify-content: center;
      align-items: center;
  }

  .Christmas_hoilday_banner_main_Slider_Slick .slick-prev:before,
  .Christmas_hoilday_banner_main_Slider_Slick .slick-next:before {
      font-size: 20px;
      color: white;
      opacity: 1;
  }

  .Christmas_hoilday_banner_main_Slider_Slick .slick-prev {
      left: 10px;
  }

  .Christmas_hoilday_banner_main_Slider_Slick .slick-next {
      right: 10px;
  }
</style>

<section class="Christmas_hoilday_banner_section">
  <div class="Christmas_hoilday_banner_Images">
    {% if section.settings['main-Christmas_hoilday_banner_desktop_img'] != blank %}
      <img
        class="Christmas_hoilday_banner_desktop_img"
        src="{{ section.settings.main-Christmas_hoilday_banner_desktop_img |img_url:'master' }}"
      >
    {% endif %}
  </div>
  <div class="Christmas_hoilday_banner_Slider_flex">
    <div class="Christmas_hoilday_banner_main_Slider_box">
      <h1 class="Christmas_hoilday_banner_main_Slider_title_desktop">
        {{ section.settings['mian-Christmas_hoilday_banner_main_Slider_title_desktop'] }}
      </h1>
      <h1 class="Christmas_hoilday_banner_main_Slider_title_mobile">
        {{ section.settings['mian-Christmas_hoilday_banner_main_Slider_title_mobile'] }}
      </h1>
      <div class="Christmas_hoilday_banner_main_Slider_inner">
        <div class="Christmas_hoilday_banner_main_Slider_wrapper">
          <div class="Christmas_hoilday_banner_main_Slider_Slick">
            {% for block in section.blocks %}
              {% assign products_product = block.settings.products_list %}
              {% if products_product != blank %}
                {% for products in products_product %}
                  <div class="Christmas_hoilday_banner_main_Slider_Slick_item">
                    <div class="Christmas_hoilday_banner_main_Slider_product_flex">
                      <div class="Christmas_hoilday_banner_main_Slider_product_box">
                        <div class="Christmas_hoilday_banner_main_Slider_product_images">
                          {% if block.settings['main-Christmas_hoilday_banner_main_Slider_badge_image'] != blank %}
                            <img
                              class="Christmas_hoilday_banner_main_Slider_badge_image"
                              src="{{ block.settings.main-Christmas_hoilday_banner_main_Slider_badge_image |img_url:'master' }}"
                            >
                          {% endif %}
                          <a href="{{ products.url }}" class="Christmas_hoilday_banner_main_Slider_product_images_Link">
                            <img
                              class="Christmas_hoilday_banner_main_Slider_product_images_Img"
                              src="{{ products.featured_image | img_url: 'master' }}"
                              alt="{{ products.title }}"
                            >
                          </a>
                          <div class="Christmas_hoilday_banner_main_Slider_product_Title">
                            <h4 class="Christmas_hoilday_banner_main_Slider_product_Title_text">
                              <a
                                href="{{ products.url }}"
                                class="Christmas_hoilday_banner_main_Slider_product_Title_link"
                              >
                                {{ products.title }}
                              </a>
                            </h4>
                          </div>
                          <div class="Christmas_hoilday_banner_main_Slider_product_price">
                            <span class="Christmas_hoilday_banner_main_Slider_product_price_span">
                              {{ products.price | money }}
                            </span>
                            {% if products.compare_at_price > products.price %}
                              <span class="Christmas_hoilday_banner_main_Slider_product_compare_price_span">
                                {{ products.compare_at_price | money }}
                              </span>
                            {% endif %}
                          </div>
                          <div class="Christmas_hoilday_banner_main_Slider_product_Button_Add_to">
                            {%- render 'new-buy-buttons',
                              block: block,
                              product: products,
                              product_form_id: product_form_id,
                              section_id: section.id,
                              show_pickup_availability: true
                            -%}
                          </div>
                          <div class="Christmas_hoilday_banner_main_Slider_product_description">
                            <p>
                              {{ products.description | strip_html }}
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<script>
$('.Christmas_hoilday_banner_main_Slider_Slick').slick({
  dots: true,
  arrows: true,
  infinite: false,
  speed: 300,
  slidesToShow: 3.5,       // show 1 slide at a time
  slidesToScroll: 1,     // scroll 1 slide per click
  customPaging: function(slider, i) {
    // Always show 4 dots total
    return '<button></button>';
  },
  responsive: [
    {
      breakpoint: 1024,
      settings: {
        slidesToShow: 3.5,
        slidesToScroll: 1,
        infinite: true,
        dots: true
      }
    },
    {
      breakpoint: 600,
      settings: {
        slidesToShow: 1,
        slidesToScroll: 1
      }
    },
    {
      breakpoint: 480,
      settings: {
        slidesToShow: 1,
        slidesToScroll: 1
      }
    }
  ]
});
</script>

{% schema %}
{
  "name": "Christmas Holiday Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "main-Christmas_hoilday_banner_desktop_img",
      "label": "Main Desktop Images"
    },
    {
      "type": "text",
      "id": "mian-Christmas_hoilday_banner_main_Slider_title_desktop",
      "label": "Main Title Desktop"
    },
    {
      "type": "textarea",
      "id": "mian-Christmas_hoilday_banner_main_Slider_title_mobile",
      "label": "Main Title Mobile"
    }
  ],
  "blocks": [
    {
      "type": "Product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "main-Christmas_hoilday_banner_main_Slider_badge_image",
          "label": "Product Top images"
        },
        {
          "type": "product_list",
          "id": "products_list",
          "label": "Products List"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Christmas Holiday Banner"
    }
  ]
}
{% endschema %}
