<style>
.C_G_section {
    padding: 80px 0;
    width: 100%;
    height: 100%;
    background-image: url({{ section.settings.main-C_G_Box_img |img_url:'master' }});
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
}

.C_G_Container {
    max-width: 952px;
    margin: 0 auto;
    width: 100%;
}


.C_G_content {
    width: 100%;
    height: 100%;
    background-image: url({{section.settings.main-C_G_Box_img2 |img_url:'master' }});
    background-repeat: no-repeat;
    background-position: top center;
    background-size: cover;
    margin-top: 50px;
}

.C_G_Title {
    margin: 0;
    text-align: center;
    font-size: 32px;
    color: #fff;
    font-weight: 700;
}

 .C_G_Box {
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
}

.C_G_Box_content {
    background: #003733;
    border: 1px solid #F1FBCC;
    border-radius: 16px;
    width: 36.7%;
    padding: 40px 24px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.C_G_img_contetn {
    width: 60.5%;
    height: 280px;
}

.C_G_Box_images {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border: 1px solid #F1FBCC;
    border-radius: 16px;
}

.C_G_Box_title {
    margin: 0;
    color: #CEF34E;
    font-size: 28px;
    font-weight: 700;
}

.C_G_Box_desp p {
    line-height: 125%;
    color: #FFFFFF;
    font-size: 14px;
}

  .box-row {
    flex-direction: row;
  }

  .box-row-reverse {
    flex-direction: row-reverse;
  }

</style>
<section class="C_G_section">
  <div class="C_G_Container">
    
    <h2 class="C_G_Title">
      {{ section.settings.main-C_G_Title }}
    </h2>

    <div class="C_G_content">
      {% for block in section.blocks %}
        <div class="C_G_Box {{ block.settings.box_flex_direction }}">
          
          <div class="C_G_Box_content">
            <h2 class="C_G_Box_title">
              {{ block.settings.main_C_G_Box_title }}
            </h2>

            <div class="C_G_Box_desp">
              <p>{{ block.settings.mian_C_G_Box_desp }}</p>
            </div>
          </div>

          <div class="C_G_img_contetn">
            {% if block.settings.mian_C_G_Box_images != blank %}
              <img 
                src="{{ block.settings.mian_C_G_Box_images | img_url: 'master' }}" 
                alt="" 
                class="C_G_Box_images"
              >
            {% endif %}
          </div>

        </div>

      {% endfor %}
    </div>

  </div>
</section>



{% schema %}
{
  "name": "C_G Custom Section",
  "settings": [
    {
      "type": "text",
      "id": "main-C_G_Title",
      "label": "Main Title",
    },
    {
    "type": "image_picker",
    "id": "main-C_G_Box_img",
    "label": "Images"
    },
    {
    "type": "image_picker",
    "id": "main-C_G_Box_img2",
    "label": "Images 2"
    }

  ],
  "blocks": [
    {
      "type": "box",
      "name": "Box",
      "settings": [
        {
          "type": "textarea",
          "id": "main_C_G_Box_title",
          "label": "Box Title",
        },
        {
          "type": "richtext",
          "id": "mian_C_G_Box_desp",
          "label": "Box Description",
        },
        {
          "type": "image_picker",
          "id": "mian_C_G_Box_images",
          "label": "Box Image"
        },
        {
          "type": "select",
          "id": "box_flex_direction",
          "label": "Box Flex Direction",
          "options": [
            {
              "value": "box-row",
              "label": "Row"
            },
            {
              "value": "box-row-reverse",
              "label": "Row Reverse"
            },
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "C_G Custom Section"
    }
  ]
}
{% endschema %}
