<style>
    .golime-industries-serve-section {
    padding-top: 27px;
    padding-bottom: 27px;
}

.golime-industries-serve-container {
    max-width: 1336px;
    width: 100%;
    margin: 0 auto;
}

.golime-industries-serve-title-text {
    font-size: 40px;
    color: #454545;
    letter-spacing: 0;
    text-align: center;
    padding-bottom: 40px;
    margin: 0;
}

.golime-industries-serve-Flex {
    display: flex;
    justify-content: space-between;
}

.golime-industries-serve-images_text_box {
    width: 49%;
}

.golime-industries-serve-images_box {
    width: 100%;
    padding-bottom: 100%;
    height: 0;
    position: relative;
}

.golime-industries-serve-images_img {
    width: 100%;
    object-fit: cover;
    height: 100%;
    border-radius: 24px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.golime-industries-serve_text_box_title {
    font-size: 28px;
    color: #454545;
    text-align: center;
    padding-top: 28px;
    padding-bottom: 30px;
    margin: 0;
}

.golime-industries-serve_text_box-para p {
    font-size: 20px;
    color: #454545;
    line-height: 1.2;
    text-align: center;
    width: 83%;
    margin: 0 auto;
}

@media screen and (max-width: 768px){

  .golime-industries-serve-Flex{
    display: block;
  }

  .golime-industries-serve-container {
    padding: 0 0px 0 15px;
}

  .golime-industries-serve-images_text_box{
    width: 100%;
  }

  .golime-industries-serve-images_box{
    padding-bottom: 100%;
  }

  .golime-industries-serve-title-text{
    font-size: 28px;
    padding-bottom: 25px;
  }

  .golime-industries-serve_text_box_title{
    font-size: 22px;
  }

  .golime-industries-serve_text_box-para p{
    font-size: 16px;
    width: 100%;
  }
}

</style>
<section class="golime-industries-serve-section">
  <div class="golime-industries-serve-container">
    <div class="golime-industries-serve-title">
      <h1 class="golime-industries-serve-title-text">
        {{ section.settings['main-golime-industries-serve-title-text'] }}
      </h1>
    </div>
    <div class="golime-industries-serve-Flex owl-carousel">
      {% for block in section.blocks %}
        <div class="golime-industries-serve-images_text_box">
          <div class="golime-industries-serve-images_box">
            {% if block.settings['mian-golime-industries-serve-images_img'] != blank %}
              <img
                src="{{ block.settings.mian-golime-industries-serve-images_img |img_url:'master' }}"
                class="golime-industries-serve-images_img"
                alt=""
              >
            {% endif %}

          </div>
          <div class="golime-industries-serve_text_box">
            <h2 class="golime-industries-serve_text_box_title">{{ block.settings.main-golime-industries-serve_text_box_title }}</h2>
            <div class="golime-industries-serve_text_box-para">
                <p>{{ block.settings.main-golime-industries-serve_text_box_para }}</p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<script>
  $(document).ready(function () {
    if ($(window).width() <= 768) {
      $('.golime-industries-serve-Flex').addClass('owl-carousel');
      $('.golime-industries-serve-Flex').owlCarousel({
        items: 1,
        loop: true,
        margin: 15,
        dots: true,
        nav: false,
        autoplay: false,
        autoplayTimeout: 4000,
        smartSpeed: 800
      });
    }
  });
</script>

{% schema %}
{
  "name": "Golime Industries Serve",
  "settings": [
    {
    "type": "text",
    "id": "main-golime-industries-serve-title-text",
    "label": "Industries Serve Title"
    }
  ],
  "blocks": [
    {
    "type": "Boxs",
    "name": "Boxs",
    "settings": [
        {
        "type": "image_picker",
        "id": "mian-golime-industries-serve-images_img",
        "label": "Industries Serve Images"
        },
        {
        "type": "text",
        "id": "main-golime-industries-serve_text_box_title",
        "label": "Industries Serve block Title"
        },
        {
        "type": "richtext",
        "id": "main-golime-industries-serve_text_box_para",
        "label": "Industries Serve block Para"
        }
    ]
    }
  ],
  "presets": [
    {
    "name": "Golime Industries Serve"
    }
  ]
}
{% endschema %}
