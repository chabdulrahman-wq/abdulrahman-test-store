
<style>
    section.Diamond_watch_video_section{
    padding-top: 60px;
    padding-bottom: 0px;
}

.Diamond_watch_video_top_title_box {
    max-width: 60%;
    margin: 0 auto;
    padding-top: 75px;
    padding-bottom: 20px;
}

.Diamond_watch_video_top_text_box {
    width: 30%;
    margin: 0 auto;
    text-align: center;
    border: 1px solid #ccc;
    border-top-right-radius: 250px;
    border-top-left-radius: 250px;
    border-bottom: none;
}

.Diamond_watch_video_top_box_img-text {
    display: flex;
    justify-content: center;
    align-items: center;
}

.Diamond_watch_video_top_box_img {
    width: 100%;
    height: 100%;
    max-width: 17.5px;
    object-fit: contain;
}

.Diamond_watch_video_top_box_text {
    color: #7e7e7e;
    font-size: 14px;
    margin: 0;
    font-weight: 300;
    font-style: italic;
    font-family: TestDomaineDisplayRegular;
    padding: 5px 3px;
}

.Diamond_watch_video_top_title {
    color: #181818;
    font-size: 26px;
    text-transform: uppercase;
    font-weight: 400;
    letter-spacing: 0;
    margin: 0;
    font-family: TestDomaineDisplayRegular;
    line-height: 1.2;
    padding-top: 4px;
    padding-bottom: 25px;
}

.Diamond_watch_video_flex_content {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #ccc;
    border-bottom: 1px solid #ccc;
}

.Diamond_watch_video_flex_content_first_box {
    width: 33%;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.Diamond_watch_video_flex_content_first_box_title {
    color: #181818;
    font-family: TestDomaineDisplayRegular;
    font-size: 26px;
    font-weight: 400;
    text-transform: uppercase;
    margin: 0;
}

.Diamond_watch_video_flex_content_first_box_description p {
    font-size: 14px;
    line-height: 24px;
    letter-spacing: .6px;
    font-family: Product Sans Regular;
    color: #7e7e7e;
    padding-top: 12px;
    font-weight: 300;
    padding-bottom: 25px;
}

.Diamond_watch_video_flex_content_first_box_button {
    display: flex;
    padding: 7px 12px;
    background: #181818;
    width: fit-content;
    color: #fff;
    text-decoration: none;
    font-size: 12px;
    font-family: Product Sans Regular;
    text-transform: uppercase;
    line-height: 24px;
    justify-content: space-between;
    align-items: center;
    transition: all .4s ease-in-out;
}

.Diamond_watch_video_flex_content_video-main-box {
    width: 30%;
    padding: 16px 30px 0;
    border-left: 1px solid #ccc;
    border-right: 1px solid #ccc;
}

.Diamond_watch_video_flex_content_video-box {
    position: relative;
    padding-bottom: 94%;
    border-top-right-radius: 285px;
    overflow: hidden;
    border-top-left-radius: 285px;
}

.main_Diamond_watch_video_flex_content_video {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    object-fit: cover;
}

.Diamond_watch_video_flex_content_Images-main-box {
    width: 33%;
}

.Diamond_watch_video_flex_content_Images-box {
    position: relative;
    height: 0;
    padding-bottom: 35%;
    max-width: 60%;
    margin: 0 auto;
    border-bottom-left-radius: 276px;
    overflow: hidden;
    border-bottom-right-radius: 250px;
}

.Diamond_watch_video_flex_content_img {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    object-fit: cover;
}

@media screen and (max-width: 767px){

  .Diamond_watch_video_top_text_box {
    width: 90%;
}

.Diamond_watch_video_section {
    padding-top: 38px;
    padding-bottom: 0px;
}

.Diamond_watch_video_top_title_box {
    padding-top: 90px;
    max-width: 52%;
}

.Diamond_watch_video_top_box_text {
    font-size: 12px;
}

.Diamond_watch_video_top_title {
    font-size: 20px;
    padding-bottom: 20px;
}

.Diamond_watch_video_flex_content {
    flex-direction: column-reverse;
}
.Diamond_watch_video_flex_content_first_box {
    align-items: center;
    text-align: center;
    width: 90%;
    padding: 40px 15px;
    margin: 0 auto;
    border-left: 1px solid #ccc;
    border-right: 1px solid #ccc;
}

.Diamond_watch_video_flex_content_video-main-box {
    width: 90%;
    margin: 0 auto;
}


.Diamond_watch_video_flex_content_video-box {
    padding-bottom: 78%;
    max-width: 62%;
    margin: 0 auto;
    margin-bottom: -1px !important;
}

.Diamond_watch_video_flex_content_Images-main-box {
    display: none;
}
}
</style>
<section class="Diamond_watch_video_section">
  <div class="Diamond_watch_video_container">
    <div class="Diamond_watch_video_top_text_box">
      <div class="Diamond_watch_video_top_title_box">
        <div class="Diamond_watch_video_top_box_img-text">
          {% if section.settings.main_Diamond_watch_video_top_box_img != blank %}
            <img
              src="{{ section.settings.main_Diamond_watch_video_top_box_img |img_url:'master'}}"
              alt=""
              class="Diamond_watch_video_top_box_img"
            >
          {% endif %}
          <h4 class="Diamond_watch_video_top_box_text">
            {{ section.settings['main-Diamond_watch_video_top_box_text'] }}
          </h4>
          {% if section.settings.main_Diamond_watch_video_top_box_img2 != blank %}
            <img
              src="{{ section.settings.main_Diamond_watch_video_top_box_img2 |img_url:'master'}}"
              alt=""
              class="Diamond_watch_video_top_box_img"
            >
          {% endif %}
        </div>
        <h2 class="Diamond_watch_video_top_title">
          {{ section.settings['mian-Diamond_watch_video_top_title'] }}
        </h2>
      </div>
    </div>
    <div class="Diamond_watch_video_flex_content">
      <div class="Diamond_watch_video_flex_content_first_box">
        <h2 class="Diamond_watch_video_flex_content_first_box_title">
          {{ section.settings['main-Diamond_watch_video_flex_content_first_box_title'] }}
        </h2>
        <div class="Diamond_watch_video_flex_content_first_box_description">
          <p>{{ section.settings['main-Diamond_watch_video_flex_content_first_box_description'] }}</p>
        </div>
        <a
          href="{{ section.settings.main-Diamond_watch_video_flex_content_first_box_button-link }}"
          class="Diamond_watch_video_flex_content_first_box_button"
        >
          {{ section.settings['main-Diamond_watch_video_flex_content_first_box_button'] }}
        </a>
      </div>
      <div class="Diamond_watch_video_flex_content_video-main-box">
        <div class="Diamond_watch_video_flex_content_video-box">
          {% if section.settings.main_Diamond_watch_video_flex_content_video-box != blank %}
            <img
              src="{{ section.settings.main_Diamond_watch_video_flex_content_video-box |img_url:'master' }}"
              class="main_Diamond_watch_video_flex_content_video" alt=""
            >
          {% endif %}
        </div>
      </div>
      <div class="Diamond_watch_video_flex_content_Images-main-box">
        <div class="Diamond_watch_video_flex_content_Images-box">
            {% if section.settings.main-Diamond_watch_video_flex_content_img !=blank %}
            <img src="{{ section.settings.main-Diamond_watch_video_flex_content_img |img_url:'master' }} " alt="" class="Diamond_watch_video_flex_content_img">
            {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Diamond Watches Section",
  "settings": [
    {
    "type": "image_picker",
    "id": "main_Diamond_watch_video_top_box_img",
    "label": "Diamond Watch Top Box Images"
    },
    {
    "type": "text",
    "id": "main-Diamond_watch_video_top_box_text",
    "label": "Diamond Watch Top Box Text"
    },
    {
    "type": "image_picker",
    "id": "main_Diamond_watch_video_top_box_img2",
    "label": "Diamond Watch Top Box Images2"
    },
    {
    "type": "text",
    "id": "mian-Diamond_watch_video_top_title",
    "label": "Diamond Watch Top Box Title"
    },
    {
    "type": "text",
    "id": "main-Diamond_watch_video_flex_content_first_box_title",
    "label": "Diamond Watch Content First Box Title"
    },
    {
    "type": "richtext",
    "id": "main-Diamond_watch_video_flex_content_first_box_description",
    "label": "Diamond Watch Content First Box Description"
    },
    {
    "type": "url",
    "id": "main-Diamond_watch_video_flex_content_first_box_button-link",
    "label": "Diamond Watch Content First Box Button Link"
    },
    {
    "type": "text",
    "id": "main-Diamond_watch_video_flex_content_first_box_button",
    "label": "Diamond Watch Content First Box Button"
    },
    {
    "type": "image_picker",
    "id": "main_Diamond_watch_video_flex_content_video-box",
    "label": "Diamond Watch Content Video Box Video"
    },
    {
   "type": "image_picker", 
   "id": "main-Diamond_watch_video_flex_content_img",
   "label": "Diamond Watch Content Images Box Img"
    }
  ],
  "presets": [
    {
    "name": "Diamond Watches Section"
    }
  ]
}
{% endschema %}
