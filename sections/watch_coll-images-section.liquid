<style>
  section.Watch_coll_Section
 {
    padding-top: 40px;
    padding-bottom: 40px;
}


.Watch_coll_content_block_box {
    width: 20%;
    border-right: 1px solid #CACACA;
    border-bottom: 1px solid #CACACA;
    border-top: 1px solid #CACACA;
}

.Watch_coll_content_block_box_flex {
    display: flex;
    justify-content: space-between;
}

a.Watch_coll_content_block_box_a
 {
    text-decoration: none;
}

.Watch_coll_content_block_box_Images {
    position: relative;
    height: 0;
    padding-bottom: 153%;
}

.Watch_coll_content_block_box_Images-img {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    object-fit: cover;
    transition: all .3s ease-in-out;
    opacity: 1;
}

.Watch_coll_content_block_box_Images-img2 {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    object-fit: cover;
    transition: all .3s ease-in-out;
    opacity: 0;
}

.Watch_coll_content_block_box_btn_flex {
    border-top: 1px solid #CACACA;
    padding: 18px 0;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all .3s ease-in-out;
}

.Watch_coll_content_block_box_btn_text {
    font-size: 15px;
    letter-spacing: 1px;
    color: #181818;
    text-transform: uppercase;
    margin: 0;
    transition: all .3s ease-in-out;
}



.Watch_coll_content_block_box_btn_arrow {
    height: 24px;
    width: 0;
}

.Watch_coll_content_block_box_btn_arrow-img {
    width: 24px;
    opacity: 0;
    transform: translate(-5px);
    transition: all .3s ease-in-out;
}

.Watch_coll_content_View_ALL_title {
    display: inline-block;
    padding: 4px 15px;
    background: #e8e8e8;
    margin-top: 20px;
    text-decoration: none;
    font-size: 13px;
    border-radius: 2px;
    letter-spacing: 1px;
    color: #181818;
    font-weight: 400;
    text-transform: uppercase;
}

.Watch_coll_content_View_ALL_title_box {
    text-align: center;
}

.Watch_coll_content_block_box:hover .Watch_coll_content_block_box_Images-img2 {
    opacity: 1;
}

.Watch_coll_content_block_box:hover:hover .Watch_coll_content_block_box_btn_arrow-img {
    opacity: 1;
    transform: translate(10px);
}

/* Desktop */
@media(min-width: 769px){
  .watch-coll-slider{
    display: flex !important;
  }
}

/* Mobile */
@media(max-width: 768px){
  .Watch_coll_content_block_box{
    width: 100%;
    border-right: none;
  }

  .watch-coll-slider{
    display: block;
  }
}


</style>
<section class="Watch_coll_Section">
  <div class="Watch_coll_container">
    <div class="Watch_coll_content_block_main_box">
      <div class="Watch_coll_content_block_box_flex owl-carousel watch-coll-slider">
        {% for block in section.blocks %}
          <div class="Watch_coll_content_block_box">
            <a href="{{ block.settings.mian-Watch_coll_content_block_box }}" class="Watch_coll_content_block_box_a">
              <div class="Watch_coll_content_block_box_Images">
                {% if block.settings.main_Watch_coll_content_block_box_Images-IMG !=blank %}
                <img
                  src="{{ block.settings.main_Watch_coll_content_block_box_Images-IMG |img_url:'master' }}"
                  class="Watch_coll_content_block_box_Images-img"
                  alt=""
                >
                    {% endif %}
                {% if block.settings.main_Watch_coll_content_block_box_Images-IMG2 !=blank %}
                <img
                  src="{{ block.settings.main_Watch_coll_content_block_box_Images-IMG2 |img_url:'master' }}"
                  class="Watch_coll_content_block_box_Images-img2"
                  alt=""
                >
                    {% endif %}
              </div>
              <div class="Watch_coll_content_block_box_btn_flex">
                <h2 class="Watch_coll_content_block_box_btn_text">{{ block.settings.main-Watch_coll_content_block_box_button_text }}</h2> 
                <div class="Watch_coll_content_block_box_btn_arrow">
                  {% if block.settings.main_Watch_coll_content_block_box_btn_arrow-IMG !=blank %}
                <img
                  src="{{ block.settings.main_Watch_coll_content_block_box_btn_arrow-IMG |img_url:'master' }}"
                  class="Watch_coll_content_block_box_btn_arrow-img"
                  alt=""
                >
                    {% endif %}
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class="Watch_coll_content_View_ALL_title_box">
      <a href="{{ section.settings.main-Watch_coll_content_View_ALL_title-link }}" class="Watch_coll_content_View_ALL_title">{{ section.settings.main_Watch_coll_content_View_ALL_title }}</a>
    </div>
  </div>
</section>
<script>
  $(document).ready(function(){
    if($(window).width() < 769){
      $('.watch-coll-slider').owlCarousel({
        loop: true,
        margin: 10,
        nav: false,
        dots: true,
        autoplay: true,
        autoplayTimeout: 3000,
        responsive:{
          0:{
            items:1
          },
          480:{
            items:2
          }
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Watch Coll images Section",
  "settings": [
    {
    "type": "url",
    "id": "main-Watch_coll_content_View_ALL_title-link",
    "label": "Url End Title View All"
    },
    {
    "type": "text",
    "id": "main_Watch_coll_content_View_ALL_title",
    "label": "End Title View All"
    }
    
  ],
  "blocks": [
    {
    "type": "Boxs",
    "name": "Boxs",
    "settings": [
      {
      "type": "url",
      "id": "mian-Watch_coll_content_block_box",
      "label": "Url Content block box"
      },
      {
      "type": "image_picker",
      "id": "main_Watch_coll_content_block_box_Images-IMG",
      "label": "Content block box Images Img"
      },
      {
      "type": "image_picker",
      "id": "main_Watch_coll_content_block_box_Images-IMG2",
      "label": "Content block box Images Img2"
      },
      {
      "type": "text",
      "id": "main-Watch_coll_content_block_box_button_text",
      "label": "Content block box Button Text"
      },
      {
      "type": "image_picker",
      "id": "main_Watch_coll_content_block_box_btn_arrow-IMG",
      "label": "Content block box Button Images Arrow"
      }
    ]
    }
  ],
  "presets": [
    {
    "name": "Watch Coll images Section"
    }
  ]
}
{% endschema %}
