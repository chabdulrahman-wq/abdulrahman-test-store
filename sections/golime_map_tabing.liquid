<style>
    .G_Tb_section {
    padding: 50px 0;
}

.G_Tb_contienr {
    max-width: 1390px;
    margin: 0 auto;
    width: 100%;
}

.G_Tb_Title {
    font-size: 34px;
    text-align: center;
    color: #454545;
    padding-bottom: 10px;
    font-weight: 800;
    margin: 0;
}

.G_Tb_box_flex {
    display: flex;
    justify-content: center;
    gap: 10px;
}

.G_Tb_Btn_title {
    color: #454545;
    border: 1px solid #D9D9D9;
    font-size: 17px;
    padding: 6px 20px;
    border-radius: 50px;
    cursor: pointer;
    display: block;
}
.G_Tb_Btn_title {
background: #d9d9d9;
}
</style>
<section class="G_Tb_section">
  <div class="G_Tb_contienr">
    <h2 class="G_Tb_Title">{{ section.settings['main-G_Tb_Title'] }}</h2>
    <div class="G_Tb_content_box">
      <div class="G_Tb_box_flex">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'TabingBox' %}
              <div class="G_Tb_Btn">
                <span class="G_Tb_Btn_title">{{ block.settings['main-G_Tb_Btn_title'] }}</span>
              </div>
          {% endcase %}
        {% endfor %}
        
      </div>
      <div class="G_Tb_Map_box">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'MapBox' %}
                <div class="G_Tb_Map_box_content">
                  <div class="G_Tb_Map_Link_box">
                    {{ block.settings.mian-G_Tb_Map_Link_box }}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Golime Map Tabing",
  "settings": [
    {
    "type": "text",
    "id": "main-G_Tb_Title",
    "label": "Main Title"
    }
  ],
  "blocks": [
    {
    "type": "TabingBox",
    "name": "Tabing Box",
    "settings": [
        {
        "type": "text",
        "id": "main-G_Tb_Btn_title",
        "label": "Tabing Btn Title"
        },
    ]
    },
    {
    "type": "MapBox",
    "name": "Map Box",
    "settings": [
        {
        "type": "textarea",
        "id": "mian-G_Tb_Map_Link_box",
        "label": "Map Link Box"
        }
    ]
    }
  ],
  "presets": [
    {
    "name": "Golime Map Tabing"
    }
  ]
}
{% endschema %}
