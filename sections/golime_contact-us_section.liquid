<style>
    .G_C_section {
      padding: 40px 0 60px;
  }

  .G_C_container {
      width: 100%;
      max-width: 1336px;
      margin: 0 auto;
  }

  .G_C_top_images {
      max-width: 46px;
      margin: 0 auto;
  }

  .G_C_top_img {
      width: 100%;
      height: 100%;
  }

  .G_C_top_content {
      margin: 22px auto 15px;
  }

  .G_C_top_Title {
      margin: 0;
      color: #454545;
      text-align: center;
      font-weight: 700;
      font-size: 40px;
      letter-spacing: 0;
      line-height: 48px;
  }

  .G_C_top_para p {
      text-align: center;
      padding-bottom: 20px;
      margin: 0 auto;
      color: #454545;
      letter-spacing: 0;
      line-height: 26px;
      display: block;
      font-size: 20px;
  }

  .G_C_Flex {
      padding: 40px 0 60px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
  }

  .G_C_Block_Box {
      padding: 25px 28px 0;
      border-radius: 24px;
      width: 32.5%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      height: 100%;
  }
  .G_C_Box_Content {
      padding: 10px 0 45px;
      min-height: 225px;
  }

  .G_C_Box_Images {
      position: relative;
      padding-bottom: 100%;
      height: 0;
      width: 100%;
      overflow: hidden;
  }

  .G_C_Box_img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      top: 0;
      left: 10px;
      transform: translateY(7%);
      transition: transform .5s ease;
  }

  .G_C_Box_Para p {
      font-size: 18px;
      margin-bottom: 30px;
      line-height: normal;
      letter-spacing: 0;
      color: #454545;
  }

  .G_C_Box_Heading {
      font-size: 28px;
          margin: 0;
      color: #454545;
      font-weight: 700;
      letter-spacing: 0;
  }

  .mian-G_C_Box_Btn {
      padding: 10.5px 12px;
      margin: 0 auto;
      font-weight: 700;
      cursor: pointer;
      width: 60%;
      border: none;
      border-radius: 20px;
      text-decoration: none;
      font-size: 16px;
      color: #454545;
  }

  .G_C_Block_Box:hover .G_C_Box_img {
      transform: translateY(0);
  }

  @media screen and (max-width: 768px){
  .G_C_Flex {
    padding: 42px 10px 60px;
      flex-direction: column;
      gap: 10px;
  }
  .G_C_Block_Box {
      width: 100%;
  }
  }
</style>

<section class="G_C_section">
  <div class="G_C_container">
    <div class="G_C_top_images">
      {% if section.settings['main-G_C_top_img'] != blank %}
        <img class="G_C_top_img" src="{{ section.settings.main-G_C_top_img |img_url:'master' }}" alt="">
      {% endif %}
    </div>
    <div class="G_C_top_content">
      <h2 class="G_C_top_Title">{{ section.settings['main-G_C_top_Title'] }}</h2>
    </div>
    <div class="G_C_top_para">
      <p>{{ section.settings['main-G_C_top_Para'] }}</p>
    </div>
    <div class="G_C_Flex">
      {% for block in section.blocks %}
        <div
          class="G_C_Block_Box"
          {% if block.settings['main-G_C_Box_Color'] != blank %}
            style="background-color: {{ block.settings.main-G_C_Box_Color }};"
          {% endif %}
        >
          <div class="G_C_Box_Content">
            <h2 class="G_C_Box_Heading">
              {{ block.settings['main-G_C_Box_Heading'] }}
            </h2>
            <div class="G_C_Box_Para">
              <p>
                {{ block.settings['mian-G_C_Box_Para'] }}
              </p>
            </div>
            <div
              {% if block.settings['main-G_C_Box_Btn_background_Color'] != blank %}
                style="
                        background-color: {{ block.settings.main-G_C_Box_Btn_background_Color }}; color: {{ block.settings.main-G_C_Box_Btn_Color }};
                "
              {% endif %}
              class="mian-G_C_Box_Btn"
            >
              {{ block.settings['main-G_C_Box_Btn'] }}
            </div>
          </div>
          <div class="G_C_Box_Images">
            {% if block.settings['main-G_C_Box_img'] != blank %}
              <img class="G_C_Box_img" src="{{ block.settings.main-G_C_Box_img |img_url:'master' }}" alt="">
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Golime Contact Us Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "main-G_C_top_img",
      "label": "G C Top Images"
    },
    {
      "type": "text",
      "id": "main-G_C_top_Title",
      "label": "G C Top Title"
    },
    {
      "type": "richtext",
      "id": "main-G_C_top_Para",
      "label": "G C Top Para"
    }
  ],
  "blocks": [
    {
      "type": "G_C_Box",
      "name": "G C Box",
      "settings": [
        {
          "type": "color",
          "id": "main-G_C_Box_Color",
          "label": "Color"
        },
        {
          "type": "text",
          "id": "main-G_C_Box_Heading",
          "label": "G C Box Heading"
        },
        {
          "type": "richtext",
          "id": "mian-G_C_Box_Para",
          "label": "G C Box Para"
        },
        {
          "type": "color",
          "id": "main-G_C_Box_Btn_Color",
          "label": "G C Box Button Color"
        },
        {
          "type": "color",
          "id": "main-G_C_Box_Btn_background_Color",
          "label": "G C Box Button Color"
        },
        {
          "type": "text",
          "id": "main-G_C_Box_Btn",
          "label": "G C Box Btn"
        },
        {
          "type": "image_picker",
          "id": "main-G_C_Box_img",
          "label": "G C Box Images"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Golime Contact Us Section"
    }
  ]
}
{% endschema %}
