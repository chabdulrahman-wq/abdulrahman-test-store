<style> 
    .Review_slider_section {
    width: 100%;
    padding-top: 110px;
    padding-bottom: 100px;
    position: relative;
}

.Review_slider_Flex {
    display: flex;
    justify-content: center;
    padding-left: 200px;
    gap: 50px;
}

.Review_slider_content_box {
    width: 37%;
}

.Review_sliders_box {
    margin-left: auto;
    margin-right: auto;
    position: relative;
    overflow: hidden;
    list-style: none;
    padding: 0;
    z-index: 1;
        width: 100%;
    display: block;
}


.Review_slider_content_Logo {
    max-width: 70px;
}

.Review_sliders_box_item {
    width: 81%;
    margin-right: 20px;
}

.Review_slider_content_logo_images {
    object-fit: cover;
    width: 100%;
    height: 100%;
}

.Review_sliders_content_Images_box_img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.Review_slider_content_title {
    margin-top: 40px;
}

.Review_slider_content_heading {
    margin: 0;
    font-size: 24px;
    letter-spacing: 0 !important;
    line-height: 32px;
    color: #181818;
    font-weight: 400;
    text-transform: uppercase;
}
</style>
<section class="Review_slider_section">
  <div class="Review_slider_container">
    <div class="Review_slider_Flex">
      <div class="Review_slider_content_box">
        <div class="Review_slider_content_Logo">
          {% if section.settings['main-Review_slider_content_logo_images'] != blank %}
            <img
              src="{{ section.settings.main-Review_slider_content_logo_images |img_url:'master' }}"
              class="Review_slider_content_logo_images"
              alt=""
            >
          {% endif %}
        </div>
        <div class="Review_slider_content_title">
          <h2 class="Review_slider_content_heading">
            {{ section.settings['main-Review_slider_content_heading'] }}
          </h2>
        </div>
        <div class="Review_slider_content_slider_icon_box">
          <div class="Review_slider_swiper_icon_prev">
            <i class="fa-solid fa-arrow-left"></i>
          </div>
          <div class="Review_slider_swiper_icon_Next">
            <i class="fa-solid fa-arrow-right"></i>
          </div>
          <div class="Review_slider_swiper_scrollbar">
            <span
              class="Review_slider_swiper_scrollbar_progressbar"
              style="transform: translate3d(0px, 0px, 0px) scaleX(0.166667) scaleY(1); transition-duration: 600ms;"
            ></span>
          </div>
        </div>
      </div>
      <div class="Review_sliders_box">
        <div class="Review_sliders_box_main_slider owl-carousel">
          {% for block in section.blocks %}
            <div class="Review_sliders_box_item">
              <div class="Review_sliders_content_Images_text_box">
                <div class="Review_sliders_content_Images_text_flex">
                  <div class="Review_sliders_content_Images_box">
                    {% if block.settings['main-Review_sliders_content_Images_box_img'] != blank %}
                      <img
                        src="{{ block.settings.main-Review_sliders_content_Images_box_img |img_url:'master' }}"
                        class="Review_sliders_content_Images_box_img"
                        alt=""
                      >
                    {% endif %}
                  </div>
                  <div class="Review_sliders_content_Text_box">
                    <div class="Review_sliders_content_Text_review_img_flex">
                      <div class="Review_sliders_content_Text_desp">
                        <h2 class="Review_sliders_content_Text_title">
                          {{ block.settings['main-Review_sliders_content_Text_Title'] }}
                        </h2>
                        <div class="Review_sliders_content_desp">
                          <p>
                            {{ block.settings['main-Review_sliders_content_desp'] }}
                          </p>
                        </div>
                      </div>
                      <div class="Review_sliders_content_review_images">
                        {% if block.settings['mian-Review_sliders_content_Text_review_img'] != blank %}
                          <img
                            src="{{ block.settings.mian-Review_sliders_content_Text_review_img |img_url:'master' }}"
                            class="Review_sliders_content_Text_review_img"
                            alt=""
                          >
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
                <div class="Review_sliders_content_logo_bottom_img_text">
                  <div class="Review_sliders_content_logo_bottom_images">
                    {% if block.settings['main-Review_sliders_content_logo_bottom_img'] != blank %}
                      <img
                        src="{{ block.settings.main-Review_sliders_content_logo_bottom_img |img_url:'master' }}"
                        class="Review_sliders_content_logo_bottom_img"
                        alt=""
                      >
                    {% endif %}
                  </div>

                  <div class="Review_sliders_content_logo_bottom_text_para">
                    <p>{{ block.settings['main-Review_sliders_content_logo_bottom_text_para'] }}</p>
                    <span class="Review_sliders_content_logo_bottom_sub_text">
                      {{- block.settings.main_Review_sliders_content_logo_bottom_sub_text -}}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  $(document).ready(function () {
    $('.Review_sliders_box_main_slider').owlCarousel({
      loop: true,
      margin: 20,
      nav: false,
      dots: false,
      autoplay: false,
      autoplayTimeout: 4000,
      autoplayHoverPause: true,
      smartSpeed: 800,
      responsive: {
        0: {
          items: 2.3,
        },
        768: {
          items: 2.3,
        },
        1024: {
          items: 2.3,
        },
      },
    });

    // Custom arrows
    $('.Review_slider_swiper_icon_prev').click(function () {
      $('.Review_sliders_box_main_slider').trigger('prev.owl.carousel');
    });

    $('.Review_slider_swiper_icon_Next').click(function () {
      $('.Review_sliders_box_main_slider').trigger('next.owl.carousel');
    });
  });
</script>

{% schema %}
{
  "name": "custom Review Slider",
  "settings": [
    {
    "type": "image_picker",
    "id": "main-Review_slider_content_logo_images",
    "label": "Review Slider Logo"
    },
    {
    "type": "text",
    "id": "main-Review_slider_content_heading",
    "label": "Review Slider Title"
    }
  ],
  "blocks": [
    {
    "type": "Slider_item",
    "name": "Slider Item",
    "settings": [
        {
        "type": "image_picker",
        "id": "main-Review_sliders_content_Images_box_img",
        "label": "Review Slider Block Images Box"
        },
        {
        "type": "text",
        "id": "main-Review_sliders_content_Text_Title",
        "label": "Review Slider Block Item Title"
        },
        {
        "type": "richtext",
        "id": "main-Review_sliders_content_desp",
        "label": "Review Slider Block Item Desp"
        },
        {
        "type": "image_picker",
        "id": "mian-Review_sliders_content_Text_review_img",
        "label": "Review Slider Block Item Review Images"
        },
        {
        "type": "image_picker",
        "id": "main-Review_sliders_content_logo_bottom_img",
        "label": "Review Slider Block Item Logo Bottom Images"
        },
        {
        "type": "richtext",
        "id": "main-Review_sliders_content_logo_bottom_text_para",
        "label": "Review Slider Block Item Logo Bottom Para"
        },
        {
        "type": "text",
        "id": "main_Review_sliders_content_logo_bottom_sub_text",
        "label": "Review Slider Block Item Logo Bottom Text"
        }
    ]
    }
  ],
  "presets": [
    {
    "name": "custom Review Slider"
    }
  ]
}
{% endschema %}
