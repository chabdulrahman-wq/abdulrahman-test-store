<style>
    .C_D_img_text {
    padding: 60px 0;
}

    .C_D_container {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
}
.C_D_Flex {
    display: flex;
    justify-content: center;
    gap: 60px;
}

.C_I_images {
    width: 50%;
}

.C_E_content {
    width: 47%;
}
.C_I_img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
    display: block;
}

.C_E_Title {
    margin: 0 0 72px;
    font-size: 40px;
    color: #454545;
    line-height: 100%;
    letter-spacing: 0 !important;
    font-weight: 700;
}

.C_E_S_item {
    display: flex;
    gap: 24px;
    align-items: self-start;
    margin-bottom: 63px;
}
</style>
<section class="C_D_img_text">
  <div class="C_D_container">
    <div class="C_D_Flex">
      <div class="C_I_images">
        {% if section.settings['main-C_I_images'] != blank %}
          <img
            class="C_I_img"
            src="{{ section.settings.main-C_I_images |img_url:'master' }}"
            alt=""
            width="100%"
            height="100%"
          >
        {% endif %}
      </div>
      <div class="C_E_content">
        <h2 class="C_E_Title">{{ section.settings.main_Title }}</h2>
        <div class="C_E_block">
          {% for block in section.blocks %}
            <div class="C_E_S_item">
              <div class="C_S_Images">
                {% if block.settings['main-C_S_img'] %}
                  <img
                    class="C_S_img"
                    src="{{ block.settings.main-C_S_img |img_url:'master' }}"
                    alt=""
                    width="100%"
                    height="100%"
                  >
                {% endif %}
              </div>
              <div class="C_S_opputinty">
                <h4 class="C_O_text">{{ block.settings['main-C_O_text'] }}</h4>
                <p>{{ block.settings.main_para }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Custom Divrsty Img Text",
  "settings": [
    {
    "type": "image_picker",
    "id": "main-C_I_images",
    "label": "Images"
    },
    {
    "type": "text",
    "id": "main_Title",
    "label": "Main Title"
    },
  ],
  "blocks": [
    {
    "type": "Boxs",
    "name": "Boxs",
    "settings": [
        {
        "type": "image_picker",
        "id": "main-C_S_img",
        "label": "Images"
        },
        {
        "type": "text",
        "id": "main-C_O_text",
        "label": "Main Text",
        },
        {
        "type": "richtext",
        "id": "main_para",
        "label": "Main Para"
        }
    ]
    }
  ],
  "presets": [
    {
    "name": "Custom Divrsty Img Text"
    }
  ]
}
{% endschema %}
