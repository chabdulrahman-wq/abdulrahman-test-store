<style>
  .golime-new-section-banner {
      padding-bottom: 40px;
  }

  .flex-golime-new-section-banner {
      display: flex
  ;
      position: relative;
      justify-content: space-between;
      flex-wrap: wrap;
  }

  .box-golime-new-section-banner-left-box {
      width: 50%;
      position: relative;
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | img_url: 'master' }}');
    {% endif %}
          height: 85vh;
      transition: 0.5s all ease-in-out;
    background-size: cover;
    background-repeat: no-repeat;
     background-position: bottom right;
  }

  .box-golime-new-section-banner-right {
      width: 50%;
           height: 85vh;
      background-image: url('{{ section.settings.golime-background_image | img_url: 'master' }}');
      transition: 0.3s all ease-in-out;
      background-size: cover;
    background-repeat: no-repeat;
    background-position: bottom left;
  }

  .golime-new-section-banner-data-left-heading {
      font-size: 22px;
      color: #454545;
      padding: 0 30px;
      max-width: 308px;
      font-weight: 700;
      margin: 0 auto;
  }

  .golime-new-section-banner-data-com-price-box-left-price-span {
      display: block;
      color: #454545;
      font-size: 20px;
      text-decoration: line-through;
      line-height: normal;
      padding: 6px 0;
  }

  .golime-new-section-banner-data-org-price-box-left-price-span {
      font-size: 33px;
      color: #454545;
          font-weight: 700;
      line-height: normal;
  }

  .golime-new-section-banner-box-main-data-left {
      margin: 0 auto 0 7%;
      max-width: 350px;
      text-align: center;
      position: relative;
      top: 35%;
  }

  .golime-new-section-banner-box-main-data-right {
      margin: 0 7% 0 auto ;
      max-width: 350px;
      text-align: center;
      position: relative;
      top: 35%;
  }

  .golime-new-section-banner-btn-a-left {
      text-decoration: none;
      color: white;
          font-weight: 700;
      padding: 0 26px;
      height: 40px;
      display: flex
  ;
      align-items: center;
      justify-content: center;
      width: fit-content;
      margin: 0 auto;
      background: #085A54;
      border-radius: 100px;
      font-size: 20px;
      transition: 0.8s all ease-in-out;
      width: 230px;
      margin-top: 10px;
  }

  .golime-new-section-banner-flex-icon-text {
      display: flex
  ;
      justify-content: space-between;
      gap: 12px;
      padding-top: 24px;
  }

  .golime-new-section-banner-flex-icon-text-box1 {
      text-align: center;
      width: 33.3%;
  }
  .golime-new-section-banner-flex-icon-text-box2 {
      text-align: center;
      width: 33.3%;
  }
  .golime-new-section-banner-flex-icon-text-box3 {
      text-align: center;
      width: 33.3%;
  }

  .icon-images-golime-new-section-banner {
      width: 32px;
      height: 32px;
      object-fit: contain;
  }

  .text-box-golime-new-section-banner {
      font-size: 12px;
      display: block;
      line-height: normal;
      color: #454545;
  }

  .box-golime-new-section-banner-left-box:hover {
      background: url({{ section.settings.background_image_hover | img_url: 'master' }});
      background-size: cover;
    background-repeat: no-repeat;
        width: 50%;
                background-position: bottom left;
  }

  .box-golime-new-section-banner-right:hover {
      background: url({{ section.settings.golime-background_image-hover | img_url: 'master' }});
       background-size: cover;
    background-repeat: no-repeat;
        width: 50%;
                background-position: bottom right;
  }
  .G_N_S_banner_mobile{
    display: none;
}

@media screen and (max-width: 767px){
.G_N_S_banner_mobile {
    display: block;
            position: relative;
        padding-bottom: 700px;
}

.flex-golime-new-section-banner {
    display: none;
}

.G_N_S_banner_mob_Img {
    object-position: bottom;
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.G_N_S_banner_mob_content {
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    margin: 0 auto;
    left: 50%;
    transform: translateX(-50%);
    position: absolute;
    width: 309px;
    top: 120px;
}

.G_N_S_mob_left-com_price {
    display: block;
    color: #454545;
    line-height: normal;
    font-size: 18px;
    text-decoration: line-through;
    text-align: center;
}

.G_N_S_mob_price {
    font-size: 20px;
    color: #454545;
    line-height: normal;
    text-align: center;
    font-weight: 700;
}

.G_N_S_mob_button {
    position: absolute;
    bottom: 39px;
    width: 297px;
    left: 50%;
    transform: translateX(-50%);
}


.G_N_S_mob_main_button {
    display: flex;
    text-align: center;
    text-decoration: none;
    color: white;
    font-size: 20px;
    height: 52px;
    align-items: center;
    background: #085A54;
    justify-content: center;
    margin-bottom: 15px;
    border-radius: 50px;
}

.G_N_S_mob_main_button-btm {
    display: flex;
    text-align: center;
    text-decoration: none;
    color: white;
    font-size: 20px;
    height: 52px;
    align-items: center;
    background: #085A54;
    justify-content: center;
    margin-bottom: 15px;
    border-radius: 50px;
}


}
</style>
<section class="golime-new-section-banner">
  <div class="container-golime-new-section-banner">
    <div class="flex-golime-new-section-banner">
      <div class="box-golime-new-section-banner-left-box">
        <div class="golime-new-section-banner-box-main-data-left">
          <h2 class="golime-new-section-banner-data-left-heading">
            {{ section.settings['golime-banner-data-left-heading'] }}
          </h2>
          <div class="golime-new-section-banner-data-price-box-left">
            <span class="golime-new-section-banner-data-com-price-box-left-price-span">
              {{ section.settings['golime-banner-box-left-price-span'] }}
            </span>
            <span class="golime-new-section-banner-data-org-price-box-left-price-span">
              {{ section.settings['golime-banner-box-left-price-span-2'] }}
            </span>
          </div>
          <a href="#" class="golime-new-section-banner-btn-a-left">
            {{ section.settings['section-banner-btn-a-left'] }}
          </a>
          <div class="golime-new-section-banner-flex-icon-text">
            <div class="golime-new-section-banner-flex-icon-text-box1">
              {% if section.settings['golime-banner-icon-images-1'] != blank %}
                <img
                  src=" {{ section.settings.golime-banner-icon-images-1 | img_url:'master' }}"
                  alt=""
                  class="icon-images-golime-new-section-banner"
                >
              {% endif %}
              <span class="text-box-golime-new-section-banner">
                {{- section.settings['golime-new-section-banner-icon-text'] -}}
              </span>
            </div>
            <div class="golime-new-section-banner-flex-icon-text-box2">
              {% if section.settings['golime-banner-icon-images-2'] != blank %}
                <img
                  src=" {{ section.settings.golime-banner-icon-images-2 | img_url:'master' }}"
                  alt=""
                  class="icon-images-golime-new-section-banner"
                >
              {% endif %}
              <span class="text-box-golime-new-section-banner">
                {{- section.settings['golime-new-section-banner-icon-text2'] -}}
              </span>
            </div>
            <div class="golime-new-section-banner-flex-icon-text-box3">
              {% if section.settings['golime-banner-icon-images-3'] != blank %}
                <img
                  src=" {{ section.settings.golime-banner-icon-images-3 | img_url:'master' }}"
                  alt=""
                  class="icon-images-golime-new-section-banner"
                >
              {% endif %}
              <span class="text-box-golime-new-section-banner">
                {{- section.settings['golime-new-section-banner-icon-text3'] -}}
              </span>
            </div>
          </div>
        </div>
      </div>
      <div class="box-golime-new-section-banner-right">
        <div class="golime-new-section-banner-box-main-data-right">
          <h2 class="golime-new-section-banner-data-left-heading">
            {{ section.settings['golime-banner-data-left-heading-2'] }}
          </h2>
          <div class="golime-new-section-banner-data-price-box-left">
            <span class="golime-new-section-banner-data-com-price-box-left-price-span">
              {{ section.settings['golime-banner-box-left-price-span-4'] }}
            </span>
            <span class="golime-new-section-banner-data-org-price-box-left-price-span">
              {{ section.settings['golime-banner-box-left-price-span-3'] }}
            </span>
          </div>
          <a href="#" class="golime-new-section-banner-btn-a-left">
            {{ section.settings['section-banner-btn-a-left-2'] }}
          </a>
          <div class="golime-new-section-banner-flex-icon-text">
            <div class="golime-new-section-banner-flex-icon-text-box1">
              {% if section.settings['golime-banner-icon-images-4'] != blank %}
                <img
                  src=" {{ section.settings.golime-banner-icon-images-4 | img_url:'master' }}"
                  alt=""
                  class="icon-images-golime-new-section-banner"
                >
              {% endif %}
              <span class="text-box-golime-new-section-banner">
                {{- section.settings['golime-new-section-banner-icon-text-2'] -}}
              </span>
            </div>
            <div class="golime-new-section-banner-flex-icon-text-box2">
              {% if section.settings['golime-banner-icon-images-5'] != blank %}
                <img
                  src=" {{ section.settings.golime-banner-icon-images-5 | img_url:'master' }}"
                  alt=""
                  class="icon-images-golime-new-section-banner"
                >
              {% endif %}
              <span class="text-box-golime-new-section-banner">
                {{- section.settings['golime-new-section-banner-icon-text-3'] -}}
              </span>
            </div>
            <div class="golime-new-section-banner-flex-icon-text-box3">
              {% if section.settings['golime-banner-icon-images-6'] != blank %}
                <img
                  src=" {{ section.settings.golime-banner-icon-images-6 | img_url:'master' }}"
                  alt=""
                  class="icon-images-golime-new-section-banner"
                >
              {% endif %}
              <span class="text-box-golime-new-section-banner">
                {{- section.settings['golime-new-section-banner-icon-text-4'] -}}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="G_N_S_banner_mobile">
      <div class="G_N_S_banner_mob_Images">
        {% if section.settings.main-G_N_S_banner_mob_Img !=blank%}
        <img src="{{ section.settings.main-G_N_S_banner_mob_Img |img_url:'master' }}" alt="" class="G_N_S_banner_mob_Img">
        {% endif %}
      </div>
      <div class="G_N_S_banner_mob_content">
        <div class="G_N_S_mob_left_price">
          <span class="G_N_S_mob_left-com_price">{{ section.settings.mian-G_N_S_mob_left-com_price }}</span>
          <span class="G_N_S_mob_price">{{ section.settings.mian-G_N_S_mob_price }}</span>
        </div>
        <div class="G_N_S_mob_right_price">
          <span class="G_N_S_mob_left-com_price">{{ section.settings.main-G_N_S_mob_right-com_price }}</span>
          <span class="G_N_S_mob_price">{{ section.settings.main-G_N_S_mob_Right_main_price }}</span>
        </div>
      </div>
      <div class="G_N_S_mob_button">
        <a href="{{ section.settings.main-G_N_S_mob_button-link }}" class="G_N_S_mob_main_button">{{ section.settings.mian-G_N_S_mob_main_button }}</a>
        <a href="{{ section.settings.main-G_N_S_mob_button-btm-link }}" class="G_N_S_mob_main_button-btm">{{ section.settings.mian-G_N_S_mob_main_button-btm }}</a>

      </div>
    </div>
  </div>
</section>
