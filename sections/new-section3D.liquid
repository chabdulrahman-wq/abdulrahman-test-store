{% style %}
#collection-steps-{{ section.id }} {
  --cs-bg: {{ section.settings.background }};
  --cs-text: {{ section.settings.text_color }};
  --cs-accent: {{ section.settings.accent_color }};
  background: var(--cs-bg);
  color: var(--cs-text);
  padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  overflow: hidden;
  text-align: center;
}

#collection-steps-{{ section.id }} * {
  box-sizing: border-box;
}

#collection-steps-{{ section.id }} .cs-container {
  max-width: 1200px;
  margin: auto;
}

#collection-steps-{{ section.id }} .cs-carousel {
  position: relative;
  height: 490px;
  max-width: 900px;
  margin: 0 auto 20px;
  perspective: 1200px;
}

#collection-steps-{{ section.id }} .cs-slide {
  position: absolute;
  width: min(460px, 68vw);
  height: 460px;
  left: 50%;
  top: 0;
  transform: translateX(-50%) scale(.75);
  opacity: 0;
  pointer-events: none;
  transition: transform .65s ease, opacity .65s ease;
  z-index: 1;
}

#collection-steps-{{ section.id }} .cs-slide.is-active {
  transform: translateX(-50%) scale(1);
  opacity: 1;
  z-index: 3;
  pointer-events: auto;
}

#collection-steps-{{ section.id }} .cs-slide.is-prev {
  transform: translateX(-88%) scale(.84);
  opacity: .62;
  z-index: 2;
  pointer-events: auto;
}

#collection-steps-{{ section.id }} .cs-slide.is-next {
  transform: translateX(-12%) scale(.84);
  opacity: .62;
  z-index: 2;
  pointer-events: auto;
}

#collection-steps-{{ section.id }} .cs-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  padding: 12px;
  background: {{ section.settings.card_background }};
  border-radius: 17px;
  box-shadow: 0 18px 40px rgba(0,0,0,.13);
  text-decoration: none;
  color: inherit;
}

#collection-steps-{{ section.id }} .cs-image {
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  border-radius: 10px;
  background: #e9e7df;
  display: flex;
  align-items: center;
  justify-content: center;
}

#collection-steps-{{ section.id }} .cs-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#collection-steps-{{ section.id }} .cs-placeholder {
  color: #777;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  font-size: 14px;
}

#collection-steps-{{ section.id }} .cs-placeholder svg {
  width: 65px;
  height: 65px;
}

#collection-steps-{{ section.id }} .cs-card-label {
  min-height: 45px;
  margin-top: 12px;
  border-radius: 10px;
  background: {{ section.settings.label_background }};
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8px 12px;
  font-size: 14px;
  font-weight: 500;
}

#collection-steps-{{ section.id }} .cs-content {
  max-width: 750px;
  margin: 0 auto;
}

#collection-steps-{{ section.id }} .cs-step {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 13px;
  opacity: .8;
}

#collection-steps-{{ section.id }} .cs-title {
  font-family: Georgia, serif;
  font-size: clamp(27px, 4vw, 36px);
  font-style: italic;
  font-weight: 500;
  margin: 0 0 12px;
  color: var(--cs-accent);
}

#collection-steps-{{ section.id }} .cs-description {
  font-size: 16px;
  line-height: 1.6;
  margin: 0 auto;
  max-width: 650px;
}

#collection-steps-{{ section.id }} .cs-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin-top: 36px;
}

#collection-steps-{{ section.id }} .cs-arrow {
  width: 49px;
  height: 49px;
  border: 1px solid var(--cs-accent);
  background: transparent;
  color: var(--cs-accent);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: .25s ease;
}

#collection-steps-{{ section.id }} .cs-arrow:hover {
  background: var(--cs-accent);
  color: white;
}

#collection-steps-{{ section.id }} .cs-arrow svg {
  width: 19px;
  height: 19px;
}

#collection-steps-{{ section.id }} .cs-dots {
  display: flex;
  align-items: center;
  gap: 9px;
}

#collection-steps-{{ section.id }} .cs-dot {
  width: 12px;
  height: 12px;
  padding: 0;
  border-radius: 50%;
  border: 1px solid var(--cs-accent);
  background: transparent;
  cursor: pointer;
}

#collection-steps-{{ section.id }} .cs-dot.is-active {
  background: var(--cs-accent);
  box-shadow: inset 0 0 0 3px var(--cs-bg);
  outline: 1px solid var(--cs-accent);
}

@media(max-width: 600px) {
  #collection-steps-{{ section.id }} {
    padding-left: 10px;
    padding-right: 10px;
  }

  #collection-steps-{{ section.id }} .cs-carousel {
    height: 350px;
  }

  #collection-steps-{{ section.id }} .cs-slide {
    width: 72vw;
    height: 330px;
  }

  #collection-steps-{{ section.id }} .cs-slide.is-prev {
    transform: translateX(-91%) scale(.78);
  }

  #collection-steps-{{ section.id }} .cs-slide.is-next {
    transform: translateX(-9%) scale(.78);
  }

  #collection-steps-{{ section.id }} .cs-card {
    padding: 9px;
  }

  #collection-steps-{{ section.id }} .cs-card-label {
    min-height: 38px;
    font-size: 12px;
  }

  #collection-steps-{{ section.id }} .cs-description {
    font-size: 14px;
  }

  #collection-steps-{{ section.id }} .cs-controls {
    margin-top: 25px;
  }
}
{% endstyle %}

<section id="collection-steps-{{ section.id }}">
  <div class="cs-container">

    <div class="cs-carousel" data-carousel>

      {% for i in (1..3) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection_item = section.settings[collection_key]
          assign image_item = collection_item.featured_image
          assign title_key = 'title_' | append: i
          assign description_key = 'description_' | append: i
          assign step_title = section.settings[title_key]
          assign step_description = section.settings[description_key]
        %}

        <div
          class="cs-slide"
          data-slide="{{ forloop.index0 }}"
          data-title="{{ step_title | escape }}"
          data-description="{{ step_description | escape }}"
        >
          {% if collection_item != blank %}
            <a class="cs-card" href="{{ collection_item.url }}">
              <div class="cs-image">
                {% if image_item != blank %}
                  {{ image_item | image_url: width: 1200 | image_tag: loading: 'lazy', alt: collection_item.title }}
                {% else %}
                  <div class="cs-placeholder">
                    <span>No collection image</span>
                  </div>
                {% endif %}
              </div>

              <div class="cs-card-label">
                {{ collection_item.title }}
              </div>
            </a>
          {% else %}
            <div class="cs-card">
              <div class="cs-image">
                <div class="cs-placeholder">
                  <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="8" y="12" width="64" height="56" rx="2"/>
                    <circle cx="25" cy="29" r="6"/>
                    <path d="M12 61L34 39L47 51L58 37L69 49"/>
                  </svg>
                  <span>Select a collection</span>
                </div>
              </div>
              <div class="cs-card-label">Collection {{ i }}</div>
            </div>
          {% endif %}
        </div>
      {% endfor %}

    </div>

    <div class="cs-content">
      <div class="cs-step" data-step>STEP 1 OF 3</div>
      <h2 class="cs-title" data-heading>
        {{ section.settings.title_1 }}
      </h2>
      <p class="cs-description" data-description>
        {{ section.settings.description_1 }}
      </p>
    </div>

    <div class="cs-controls">
      <button class="cs-arrow" type="button" data-prev aria-label="Previous collection">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18L9 12L15 6"/>
        </svg>
      </button>

      <div class="cs-dots">
        {% for i in (1..3) %}
          <button
            class="cs-dot"
            type="button"
            data-dot="{{ forloop.index0 }}"
            aria-label="Go to collection {{ i }}"
          ></button>
        {% endfor %}
      </div>

      <button class="cs-arrow" type="button" data-next aria-label="Next collection">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18L15 12L9 6"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<script>
(function() {
  const section = document.getElementById('collection-steps-{{ section.id }}');
  if (!section || section.dataset.initialized === 'true') return;
  section.dataset.initialized = 'true';

  const slides = Array.from(section.querySelectorAll('[data-slide]'));
  const dots = Array.from(section.querySelectorAll('[data-dot]'));
  const heading = section.querySelector('[data-heading]');
  const description = section.querySelector('[data-description]');
  const step = section.querySelector('[data-step]');
  const prev = section.querySelector('[data-prev]');
  const next = section.querySelector('[data-next]');

  let current = 0;

  function updateCarousel() {
    slides.forEach((slide, index) => {
      slide.classList.remove('is-active', 'is-prev', 'is-next');

      if (index === current) {
        slide.classList.add('is-active');
      } else if (index === (current + slides.length - 1) % slides.length) {
        slide.classList.add('is-prev');
      } else if (index === (current + 1) % slides.length) {
        slide.classList.add('is-next');
      }
    });

    dots.forEach((dot, index) => {
      dot.classList.toggle('is-active', index === current);
      dot.setAttribute('aria-current', index === current ? 'step' : 'false');
    });

    const activeSlide = slides[current];

    if (activeSlide) {
      heading.textContent = activeSlide.dataset.title || '';
      description.textContent = activeSlide.dataset.description || '';
      step.textContent = 'STEP ' + (current + 1) + ' OF ' + slides.length;
    }
  }

  function goTo(index) {
    current = (index + slides.length) % slides.length;
    updateCarousel();
  }

  prev.addEventListener('click', () => goTo(current - 1));
  next.addEventListener('click', () => goTo(current + 1));

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => goTo(index));
  });

  slides.forEach((slide, index) => {
    slide.addEventListener('click', (event) => {
      if (index !== current) {
        event.preventDefault();
        goTo(index);
      }
    });
  });

  updateCarousel();
})();
</script>

