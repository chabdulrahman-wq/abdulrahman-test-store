{% style %}
#collection-steps-{{ section.id }} {
  background: {{ section.settings.background }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  overflow: hidden;
  text-align: center;
}

#collection-steps-{{ section.id }} * { box-sizing: border-box; }

#collection-steps-{{ section.id }} .cs-container {
  max-width: 1200px;
  margin: auto;
}

#collection-steps-{{ section.id }} .cs-carousel {
  position: relative;
  height: 490px;
  max-width: 900px;
  margin: 0 auto 20px;
  perspective: 1200px;
}

#collection-steps-{{ section.id }} .cs-slide {
  position: absolute;
  width: min(460px, 68vw);
  height: 460px;
  left: 50%;
  top: 0;
  transform: translateX(-50%) scale(.75);
  opacity: 0;
  pointer-events: none;
  transition: transform .65s ease, opacity .65s ease;
  z-index: 1;
}

#collection-steps-{{ section.id }} .cs-slide.is-active {
  transform: translateX(-50%) scale(1);
  opacity: 1;
  z-index: 3;
  pointer-events: auto;
}

#collection-steps-{{ section.id }} .cs-slide.is-prev {
  transform: translateX(-88%) scale(.84);
  opacity: .62;
  z-index: 2;
  pointer-events: auto;
}

#collection-steps-{{ section.id }} .cs-slide.is-next {
  transform: translateX(-12%) scale(.84);
  opacity: .62;
  z-index: 2;
  pointer-events: auto;
}

#collection-steps-{{ section.id }} .cs-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  padding: 12px;
  background: {{ section.settings.card_background }};
  border-radius: 17px;
  box-shadow: 0 18px 40px rgba(0,0,0,.13);
  text-decoration: none;
  color: inherit;
}

#collection-steps-{{ section.id }} .cs-image {
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  border-radius: 10px;
  background: #e9e7df;
  display: flex;
  align-items: center;
  justify-content: center;
}

#collection-steps-{{ section.id }} .cs-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#collection-steps-{{ section.id }} .cs-placeholder {
  color: #777;
  font-size: 14px;
}

#collection-steps-{{ section.id }} .cs-card-label {
  min-height: 45px;
  margin-top: 12px;
  border-radius: 10px;
  background: {{ section.settings.label_background }};
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 8px 12px;
  font-size: 14px;
  font-weight: 500;
}

#collection-steps-{{ section.id }} .cs-content {
  max-width: 750px;
  margin: 0 auto;
}

#collection-steps-{{ section.id }} .cs-step {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 13px;
  opacity: .8;
}

#collection-steps-{{ section.id }} .cs-title {
  font-family: Georgia, serif;
  font-size: clamp(27px, 4vw, 36px);
  font-style: italic;
  font-weight: 500;
  margin: 0 0 12px;
  color: {{ section.settings.accent_color }};
}

#collection-steps-{{ section.id }} .cs-description {
  font-size: 16px;
  line-height: 1.6;
  margin: 0 auto;
  max-width: 650px;
}

#collection-steps-{{ section.id }} .cs-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin-top: 36px;
}

#collection-steps-{{ section.id }} .cs-arrow {
  width: 49px;
  height: 49px;
  border: 1px solid {{ section.settings.accent_color }};
  background: transparent;
  color: {{ section.settings.accent_color }};
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: .25s ease;
}

#collection-steps-{{ section.id }} .cs-arrow:hover {
  background: {{ section.settings.accent_color }};
  color: white;
}

#collection-steps-{{ section.id }} .cs-arrow svg {
  width: 19px;
  height: 19px;
}

#collection-steps-{{ section.id }} .cs-dots {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-wrap: wrap;
  justify-content: center;
}

#collection-steps-{{ section.id }} .cs-dot {
  width: 12px;
  height: 12px;
  padding: 0;
  border-radius: 50%;
  border: 1px solid {{ section.settings.accent_color }};
  background: transparent;
  cursor: pointer;
}

#collection-steps-{{ section.id }} .cs-dot.is-active {
  background: {{ section.settings.accent_color }};
  box-shadow: inset 0 0 0 3px {{ section.settings.background }};
  outline: 1px solid {{ section.settings.accent_color }};
}

@media(max-width: 600px) {
  #collection-steps-{{ section.id }} {
    padding-left: 10px;
    padding-right: 10px;
  }

  #collection-steps-{{ section.id }} .cs-carousel {
    height: 350px;
  }

  #collection-steps-{{ section.id }} .cs-slide {
    width: 72vw;
    height: 330px;
  }

  #collection-steps-{{ section.id }} .cs-slide.is-prev {
    transform: translateX(-91%) scale(.78);
  }

  #collection-steps-{{ section.id }} .cs-slide.is-next {
    transform: translateX(-9%) scale(.78);
  }

  #collection-steps-{{ section.id }} .cs-card {
    padding: 9px;
  }

  #collection-steps-{{ section.id }} .cs-card-label {
    min-height: 38px;
    font-size: 12px;
  }

  #collection-steps-{{ section.id }} .cs-description {
    font-size: 14px;
  }

  #collection-steps-{{ section.id }} .cs-controls {
    margin-top: 25px;
  }
}
{% endstyle %}

<section id="collection-steps-{{ section.id }}">
  <div class="cs-container">

    {% assign total_slides = section.blocks.size %}

    <div class="cs-carousel" data-carousel>

      {% for block in section.blocks %}
        {% assign collection_item = block.settings.collection %}

        <div
          class="cs-slide"
          data-slide="{{ forloop.index0 }}"
          data-title="{{ block.settings.heading | escape }}"
          data-description="{{ block.settings.description | escape }}"
          {{ block.shopify_attributes }}
        >

          {% if collection_item != blank %}
            <a class="cs-card" href="{{ collection_item.url }}">

              <div class="cs-image">
                {% if collection_item.featured_image != blank %}
                  {{
                    collection_item.featured_image
                    | image_url: width: 1200
                    | image_tag: loading: 'lazy', alt: collection_item.title
                  }}
                {% else %}
                  <div class="cs-placeholder">No collection image</div>
                {% endif %}
              </div>

              <div class="cs-card-label">
                {{ collection_item.title }}
              </div>

            </a>
          {% else %}
            <div class="cs-card">
              <div class="cs-image">
                <div class="cs-placeholder">Select a collection</div>
              </div>
              <div class="cs-card-label">
                {{ block.settings.heading | default: 'New Collection' }}
              </div>
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>

    <div class="cs-content">
      <div class="cs-step" data-step>
        STEP 1 OF {{ total_slides }}
      </div>

      <h2 class="cs-title" data-heading>
        {% if section.blocks.first != blank %}
          {{ section.blocks.first.settings.heading }}
        {% endif %}
      </h2>

      <p class="cs-description" data-description>
        {% if section.blocks.first != blank %}
          {{ section.blocks.first.settings.description }}
        {% endif %}
      </p>
    </div>

    <div class="cs-controls">
      <button class="cs-arrow" type="button" data-prev aria-label="Previous collection">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18L9 12L15 6"/>
        </svg>
      </button>

      <div class="cs-dots">
        {% for block in section.blocks %}
          <button
            class="cs-dot"
            type="button"
            data-dot="{{ forloop.index0 }}"
            aria-label="Go to collection {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>

      <button class="cs-arrow" type="button" data-next aria-label="Next collection">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18L15 12L9 6"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<script>
(function() {
  const section = document.getElementById('collection-steps-{{ section.id }}');
  if (!section || section.dataset.initialized === 'true') return;

  section.dataset.initialized = 'true';

  const slides = Array.from(section.querySelectorAll('[data-slide]'));
  const dots = Array.from(section.querySelectorAll('[data-dot]'));

  const heading = section.querySelector('[data-heading]');
  const description = section.querySelector('[data-description]');
  const step = section.querySelector('[data-step]');

  const prev = section.querySelector('[data-prev]');
  const next = section.querySelector('[data-next]');

  let current = 0;
  const total = slides.length;

  if (!total) {
    section.querySelector('.cs-controls').style.display = 'none';
    return;
  }

  function updateCarousel() {
    slides.forEach((slide, index) => {
      slide.classList.remove('is-active', 'is-prev', 'is-next');

      if (index === current) {
        slide.classList.add('is-active');
      } else if (total >= 3 && index === (current - 1 + total) % total) {
        slide.classList.add('is-prev');
      } else if (total >= 2 && index === (current + 1) % total) {
        slide.classList.add('is-next');
      }
    });

    dots.forEach((dot, index) => {
      dot.classList.toggle('is-active', index === current);
      dot.setAttribute('aria-current', index === current ? 'step' : 'false');
    });

    const activeSlide = slides[current];

    heading.textContent = activeSlide.dataset.title || '';
    description.textContent = activeSlide.dataset.description || '';
    step.textContent = 'STEP ' + (current + 1) + ' OF ' + total;
  }

  function goTo(index) {
    current = (index + total) % total;
    updateCarousel();
  }

  prev.addEventListener('click', () => goTo(current - 1));
  next.addEventListener('click', () => goTo(current + 1));

  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => goTo(index));
  });

  slides.forEach((slide, index) => {
    slide.addEventListener('click', (event) => {
      if (index !== current) {
        event.preventDefault();
        goTo(index);
      }
    });
  });

  updateCarousel();

  document.addEventListener('shopify:section:unload', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      section.dataset.initialized = 'false';
    }
  });
})();
</script>

{% schema %}
{
  "name": "Collection Steps Carousel",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Carousel Design"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background Color",
      "default": "#f5f3eb"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#e9e7df"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Collection Label Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#303d38"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#294b43"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection_slide",
      "name": "Collection Slide",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore Collections"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Discover our carefully selected collection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Steps Carousel",
      "blocks": [
        {
          "type": "collection_slide"
        },
        {
          "type": "collection_slide"
        },
        {
          "type": "collection_slide"
        }
      ]
    }
  ]
}
{% endschema %}