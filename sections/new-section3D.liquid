{% style %}
#collection-steps-{{ section.id }} {
  background: {{ section.settings.background_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  overflow: hidden;
}

#collection-steps-{{ section.id }} .cs-inner {
  max-width: 1200px;
  margin: 0 auto;
}

#collection-steps-{{ section.id }} .cs-heading {
  text-align: center;
  margin-bottom: 25px;
  font-size: 32px;
  font-weight: 700;
}

#collection-steps-{{ section.id }} .cs-stage {
  position: relative;
  height: 440px;
  max-width: 850px;
  margin: 0 auto;
  perspective: 1200px;
}

#collection-steps-{{ section.id }} .cs-slide {
  position: absolute;
  width: 300px;
  height: 360px;
  left: 50%;
  top: 15px;
  transform: translateX(-50%);
  opacity: 0;
  visibility: hidden;
  transition: all .55s ease;
  border-radius: 22px;
  overflow: hidden;
  background: {{ section.settings.card_background }};
  box-shadow: 0 18px 40px rgba(0,0,0,.16);
}

#collection-steps-{{ section.id }} .cs-slide.is-active {
  opacity: 1;
  visibility: visible;
  z-index: 3;
  transform: translateX(-50%) translateY(0) scale(1);
}

#collection-steps-{{ section.id }} .cs-slide.is-next {
  opacity: .75;
  visibility: visible;
  z-index: 2;
  transform: translateX(-50%) translateY(35px) scale(.82);
}

#collection-steps-{{ section.id }} .cs-slide.is-prev {
  opacity: .75;
  visibility: visible;
  z-index: 1;
  transform: translateX(-112%) translateY(5px) scale(.82);
}

#collection-steps-{{ section.id }} .cs-slide a.cs-card-link {
  display: block;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

#collection-steps-{{ section.id }} .cs-image {
  width: 100%;
  height: 100%;
  position: relative;
}

#collection-steps-{{ section.id }} .cs-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#collection-steps-{{ section.id }} .cs-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eeeeee;
  color: #555;
}

#collection-steps-{{ section.id }} .cs-card-title {
  position: absolute;
  left: 15px;
  right: 15px;
  bottom: 15px;
  padding: 13px;
  text-align: center;
  border-radius: 12px;
  background: {{ section.settings.label_background }};
  color: {{ section.settings.text_color }};
  font-weight: 700;
  font-size: 17px;
}

#collection-steps-{{ section.id }} .cs-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18px;
  margin-top: 5px;
}

#collection-steps-{{ section.id }} .cs-arrow {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 50%;
  background: {{ section.settings.accent_color }};
  color: #fff;
  font-size: 22px;
  cursor: pointer;
}

#collection-steps-{{ section.id }} .cs-count {
  font-size: 14px;
  font-weight: 600;
}

#collection-steps-{{ section.id }} .cs-side-button-wrap {
  text-align: center;
  margin-top: 12px;
}

#collection-steps-{{ section.id }} .cs-side-button,
#collection-steps-{{ section.id }} .cs-bottom-button {
  display: inline-block;
  padding: 13px 28px;
  border-radius: 30px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  text-decoration: none;
  font-weight: 700;
  transition: opacity .2s ease;
}

#collection-steps-{{ section.id }} .cs-side-button:hover,
#collection-steps-{{ section.id }} .cs-bottom-button:hover {
  opacity: .85;
}

#collection-steps-{{ section.id }} .cs-bottom-button-wrap {
  text-align: center;
  margin-top: 25px;
}

@media (max-width: 600px) {
  #collection-steps-{{ section.id }} .cs-heading {
    font-size: 25px;
  }

  #collection-steps-{{ section.id }} .cs-stage {
    height: 365px;
  }

  #collection-steps-{{ section.id }} .cs-slide {
    width: 245px;
    height: 300px;
  }

  #collection-steps-{{ section.id }} .cs-slide.is-prev {
    transform: translateX(-90%) translateY(5px) scale(.78);
  }

  #collection-steps-{{ section.id }} .cs-slide.is-next {
    transform: translateX(-50%) translateY(30px) scale(.78);
  }

  #collection-steps-{{ section.id }} .cs-side-button,
  #collection-steps-{{ section.id }} .cs-bottom-button {
    padding: 11px 22px;
    font-size: 14px;
  }
}
{% endstyle %}

<section id="collection-steps-{{ section.id }}">
  <div class="cs-inner">

    {% if section.settings.heading != blank %}
      <h2 class="cs-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="cs-stage" data-cs-stage>
      {% for block in section.blocks %}
        {% assign collection_item = block.settings.collection %}
        <div
          class="cs-slide{% if forloop.first %} is-active{% endif %}"
          data-cs-slide
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {% if collection_item != blank %}
            <a
              class="cs-card-link"
              href="{% if block.settings.card_custom_link != blank %}{{ block.settings.card_custom_link }}{% else %}{{ collection_item.url }}{% endif %}"
            >
              <div class="cs-image">
                {% if collection_item.featured_image != blank %}
                  <img
                    src="{{ collection_item.featured_image | image_url: width: 900 }}"
                    alt="{{ collection_item.title | escape }}"
                    loading="lazy"
                    width="900"
                    height="1100"
                  >
                {% else %}
                  <div class="cs-placeholder">Collection Image</div>
                {% endif %}

                <div class="cs-card-title">
                  {% if block.settings.heading != blank %}
                    {{ block.settings.heading }}
                  {% else %}
                    {{ collection_item.title }}
                  {% endif %}
                </div>
              </div>
            </a>
          {% else %}
            <div class="cs-image">
              <div class="cs-placeholder">Select a Collection</div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="cs-controls">
        <button class="cs-arrow" type="button" data-cs-prev aria-label="Previous collection">‹</button>
        <span class="cs-count" data-cs-count>1 / {{ section.blocks.size }}</span>
        <button class="cs-arrow" type="button" data-cs-next aria-label="Next collection">›</button>
      </div>

      <div class="cs-side-button-wrap">
        <a
          class="cs-side-button"
          data-cs-side-button
          href="{{ section.blocks.first.settings.card_custom_link | default: section.blocks.first.settings.collection.url | default: '#' }}"
        >
          {{ section.settings.side_button_text | escape }}
        </a>
      </div>
    {% endif %}

    {% if section.settings.bottom_button_text != blank %}
      <div class="cs-bottom-button-wrap">
        <a
          class="cs-bottom-button"
          href="{{ section.settings.bottom_custom_link | default: '/collections' }}"
        >
          {{ section.settings.bottom_button_text | escape }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<script>
(function () {
  const root = document.getElementById('collection-steps-{{ section.id }}');
  if (!root || root.dataset.initialized === 'true') return;
  root.dataset.initialized = 'true';

  const slides = Array.from(root.querySelectorAll('[data-cs-slide]'));
  const prev = root.querySelector('[data-cs-prev]');
  const next = root.querySelector('[data-cs-next]');
  const count = root.querySelector('[data-cs-count]');
  const sideButton = root.querySelector('[data-cs-side-button]');

  if (!slides.length) return;

  const slideData = [
    {% for block in section.blocks %}
      {
        url: {{ block.settings.card_custom_link | default: block.settings.collection.url | default: '#' | json }},
        title: {{ block.settings.heading | default: block.settings.collection.title | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  let current = 0;

  function update() {
    const total = slides.length;

    slides.forEach((slide, index) => {
      slide.classList.remove('is-active', 'is-next', 'is-prev');

      if (index === current) {
        slide.classList.add('is-active');
      } else if (index === (current + 1) % total) {
        slide.classList.add('is-next');
      } else if (index === (current - 1 + total) % total) {
        slide.classList.add('is-prev');
      }
    });

    if (count) count.textContent = (current + 1) + ' / ' + total;

    if (sideButton && slideData[current]) {
      sideButton.href = slideData[current].url || '#';
    }
  }

  function goTo(index) {
    current = (index + slides.length) % slides.length;
    update();
  }

  if (prev) prev.addEventListener('click', () => goTo(current - 1));
  if (next) next.addEventListener('click', () => goTo(current + 1));

  slides.forEach((slide, index) => {
    const link = slide.querySelector('.cs-card-link');
    if (!link) return;

    link.addEventListener('click', function (event) {
      if (index !== current) {
        event.preventDefault();
        goTo(index);
      }
    });
  });

  update();
})();
</script>

{% schema %}
{
  "name": "Collection 3D Carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Explore Our Collections"
    },
    {
      "type": "text",
      "id": "side_button_text",
      "label": "Side box button text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "bottom_custom_link",
      "label": "Bottom button custom link",
      "info": "Choose All Collections or paste a custom page URL."
    },
    {
      "type": "text",
      "id": "bottom_button_text",
      "label": "Bottom button text",
      "default": "Explore All Collections"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "label_background",
      "label": "Card title background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection_slide",
      "name": "Collection slide",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card heading",
          "default": "Collection"
        },
        {
          "type": "url",
          "id": "card_custom_link",
          "label": "Side box custom link",
          "info": "Optional: choose a page or paste a custom URL. Leave empty to use the selected collection."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection 3D Carousel",
      "blocks": [
        { "type": "collection_slide" },
        { "type": "collection_slide" },
        { "type": "collection_slide" }
      ]
    }
  ]
}
{% endschema %}