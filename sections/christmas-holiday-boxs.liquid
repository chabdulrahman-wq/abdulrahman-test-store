<style>
    .Unlock_even_More_Savings_section {
    background: linear-gradient(180deg, #1E4432 0%, #12281D 100%);
    padding-top: 30px;
    padding-bottom: 51px;
}

.Unlock_even_More_Savings_container {
    padding: 0 20px;
    max-width: 1115px;
    margin: 0 auto;
}

.Unlock_even_More_Savings_Title {
    font-size: 40px;
    color: #fff;
    text-align: center;
    line-height: 1.2;
    padding-bottom: 45px;
}

.Unlock_even_More_Savings_Flex {
    display: flex;
    justify-content: space-between;
    gap: 36px;
}

.Unlock_even_More_Savings_Box {
    width: 50%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.1)), radial-gradient(51.41% 100% at 100% 0.07%, rgba(196, 255, 86, 0.5) 0%, rgba(196, 255, 86, 0) 100%);
    padding: 20px;
    border-radius: 24px;
    height: 264px;
    transition: all 0.6s ease-in-out;
}

.Unlock_even_More_Savings_content {
    width: 55%;
}

.Unlock_even_More_Savings_box_title {
    font-size: 28px;
    color: #fff;
    letter-spacing: 0;
    line-height: 1.1;
}

.Unlock_even_More_Savings_content p {
    color: #fff;
    line-height: 1.4;
    padding-top: 12px;
    letter-spacing: 0;
}

.Unlock_even_More_Savings_Box_right_sides_images {
    width: 45%;
    text-align: end;
}

.Unlock_even_More_Savings_Box_right_sides_images_img {
    height: 100%;
    object-fit: cover;
    text-align: end;
    width: 100%;
}

.Unlock_even_More_Savings_Box:before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0px;
    background: linear-gradient(0deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0)), radial-gradient(51.41% 100% at 100% 0%, rgba(196, 255, 86, 0.9) 0%, rgba(196, 255, 86, 0) 100%);
    opacity: 0;
    transition: opacity .6s ease-in-out;
    z-index: 0;
}

.Unlock_even_More_Savings_Box:hover:before {
    opacity: 1;
}
</style>
<section class="Unlock_even_More_Savings_section">
  <div class="Unlock_even_More_Savings_container">
    <h2 class="Unlock_even_More_Savings_Title">{{ section.settings['main-Unlock_even_More_Savings_Title'] }}</h2>
    <div class="Unlock_even_More_Savings_Flex">
      {% for block in section.blocks %}
        <div class="Unlock_even_More_Savings_Box">
          <div class="Unlock_even_More_Savings_content">
            <h3 class="Unlock_even_More_Savings_box_title">
              {{ block.settings['main-Unlock_even_More_Savings_box-title'] }}
            </h3>
            <p>
              {{ block.settings['main-main-Unlock_even_More_Savings_box-description'] }}
            </p>
          </div>
          <div class="Unlock_even_More_Savings_Box_right_sides_images">
            {% if block.settings['main-Unlock_even_More_Savings_Box_right_sides_images_img'] != blank %}
              <img
                class="Unlock_even_More_Savings_Box_right_sides_images_img"
                src="{{ block.settings.main-Unlock_even_More_Savings_Box_right_sides_images_img |img_url:'master' }}"
              >
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Christmas Holiday Box",
  "settings": [
    {
      "type": "text",
      "id": "main-Unlock_even_More_Savings_Title",
      "label": "Title"
    }
  ],
  "blocks": [
    {
    "type": "Box",
    "name": "Box",
    "settings": [
        {
        "type": "text",
        "id": "main-Unlock_even_More_Savings_box-title",
        "label": "Box Title"
        },
        {
        "type": "richtext",
        "id": "main-main-Unlock_even_More_Savings_box-description",
        "label": "Box Description"
        },
        {
        "type": "image_picker",
        "id": "main-Unlock_even_More_Savings_Box_right_sides_images_img",
        "label": "Box Right Sides Images"
        }
    ]
    }
  ],
  "presets": [
    {
    "name": "Christmas Holiday Box"
    }
  ]
}
{% endschema %}
