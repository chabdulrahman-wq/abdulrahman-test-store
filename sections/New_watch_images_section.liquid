<section class="Watchs_images_section">
  <div class="Watchs_images_container">
    <div class="Watchs_images_content">
      <div class="Watchs_images_img_box">
        {% if section.settings['main-Watchs_images_img'] != blank %}
          <img
            class="Watchs_images_img"
            src="{{ section.settings.main-Watchs_images_img | img_url: 'master' }}"
            alt=""
          >
        {% endif %}
      </div>
    </div>
    <div class="Watchs_images_text_content">
      <div class="Watchs_images_text_content-sub-text">
        <p>{{ section.settings['mian-Watchs_images_text_content-sub-text'] }}</p>
      </div>
      <div class="Watchs_images_text_content-sub-title">
        <h2 class="Watchs_images_text_content-title">
          {{ section.settings['main-Watchs_images_text_content-title'] }}
        </h2>
      </div>
      <div class="Watchs_images_text_content-sub-desp">
        <p>{{ section.settings['main-Watchs_images_text_content-sub-desp'] }}</p>
      </div>
      <div class="Watchs_images_text_content-sub-button">
        <a
          href="{{ section.settings.main-Watchs_images_text_content-sub-button-link }}"
          class="Watchs_images_text_content-button"
        >
          {{ section.settings['mian-Watchs_images_text_content-sub-button'] }}
          <div class="Watchs_images_text_content-button-icon-images">
            {% if section.settings['Watchs_images_text_content-button-icon-images-img'] != blank %}
              <img
                class="Watchs_images_img"
                src="{{ section.settings.Watchs_images_text_content-button-icon-images-img | img_url: 'master' }}"
                alt=""
              >
            {% endif %}
          </div>
        </a>
      </div>
    </div>
    <div class="Watchs_images_img_content">
      <div class="Watchs_images_img_content-logo">
        <div class="Watchs_images_img_content-logo-box1">
          {% if section.settings['main-Watchs_images_img_content-logo-box_img1'] != blank %}
            <img
              class="Watchs_images_img_content-logo-box"
              src="{{ section.settings.main-Watchs_images_img_content-logo-box_img1 | img_url: 'master' }}"
              alt=""
            >
          {% endif %}
        </div>
        <div class="Watchs_images_img_content-logo-box2">
          {% if section.settings['main-Watchs_images_img_content-logo-box_img2'] != blank %}
            <img
              class="Watchs_images_img_content-logo-box"
              src="{{ section.settings.main-Watchs_images_img_content-logo-box_img2 | img_url: 'master' }}"
              alt=""
            >
          {% endif %}
        </div>
        <div class="Watchs_images_img_content-logo-box3">
          {% if section.settings['main-Watchs_images_img_content-logo-box_img3'] != blank %}
            <img
              class="Watchs_images_img_content-logo-box"
              src="{{ section.settings.main-Watchs_images_img_content-logo-box_img3 | img_url: 'master' }}"
              alt=""
            >
          {% endif %}
        </div>
        <div class="Watchs_images_img_content-logo-box4">
          {% if section.settings['main-Watchs_images_img_content-logo-box_img4'] != blank %}
            <img
              class="Watchs_images_img_content-logo-box"
              src="{{ section.settings.main-Watchs_images_img_content-logo-box_img4 | img_url: 'master' }}"
              alt=""
            >
          {% endif %}
        </div>
        <div class="Watchs_images_img_content-logo-box5">
          {% if section.settings['main-Watchs_images_img_content-logo-box_img5'] != blank %}
            <img
              class="Watchs_images_img_content-logo-box"
              src="{{ section.settings.main-Watchs_images_img_content-logo-box_img5 | img_url: 'master' }}"
              alt=""
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Watchs Images Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "main-Watchs_images_img",
      "label": "Watchs Main Images Box"
    },
    {
    "type": "richtext",
    "id": "mian-Watchs_images_text_content-sub-text",
    "label": "Watchs Main Text Box"
    },
    {
    "type": "text",
    "id": "main-Watchs_images_text_content-title",
    "label": "Watchs Main Title Box"
    },
    {
    "type": "richtext",
    "id": "main-Watchs_images_text_content-sub-desp",
    "label": "Watchs Main Para Box"
    },
    {
    "type": "url",
    "id": "main-Watchs_images_text_content-sub-button-link",
    "label": "Watchs Main Button Link Box"
    },
    {
    "type": "text",
    "id": "mian-Watchs_images_text_content-sub-button",
    "label": "Watchs Main Button Box"
    },
    {
    "type": "image_picker",
    "id": "Watchs_images_text_content-button-icon-images-img",
    "label": "Watchs Main Button Link Box"
    },
    {
    "type": "image_picker",
    "id": "main-Watchs_images_img_content-logo-box_img1",
    "label": "Watchs Main Images Logo Box1"
    },
    {
    "type": "image_picker",
    "id": "main-Watchs_images_img_content-logo-box_img2",
    "label": "Watchs Main Images Logo Box2"
    },
    {
    "type": "image_picker",
    "id": "main-Watchs_images_img_content-logo-box_img3",
    "label": "Watchs Main Images Logo Box3"
    },
    {
    "type": "image_picker",
    "id": "main-Watchs_images_img_content-logo-box_img4",
    "label": "Watchs Main Images Logo Box4"
    },
    {
    "type": "image_picker",
    "id": "main-Watchs_images_img_content-logo-box_img5",
    "label": "Watchs Main Images Logo Box5"
    },
  ],
  "presets": [
    {
    "name": "Watchs Images Section"
    }
  ]
}
{% endschema %}
