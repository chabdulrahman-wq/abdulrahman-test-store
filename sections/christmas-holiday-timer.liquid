
<style>
   .christmas-holiday-timer-section {
    padding-top: 20px;
    padding-bottom: 40px;
    position: relative;
    z-index: 1;
    height: 320px;
    background: linear-gradient(358deg, #1E4432 0%, #12281D 100%); 
}

.christmas-holiday-timer-flex {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.christmas-holiday-timer-left-box-images {
    width: 34.5%;
}
.christmas-holiday-timer-right-box-images {
    width: 34.5%;
}

.christmas-holiday-timer-right {
    width: 30%;
}

.christmas-holiday-timer-left-box-img {
    width: 100%;
}

.christmas-holiday-timer-left-box-img-moblie {
    width: 100%;
    display: none;
}
.christmas-holiday-timer-right-box-img {
    width: 100%;
}

.christmas-holiday-timer-right-box-img-moblie {
    width: 100%;
    display: none;
}

.christmas-holiday-timer-right_timer-heading {
    font-weight: 750;
    line-height: 100%;
    letter-spacing: 0;
    text-align: center;
    font-size: 28px;
    color: #fff;
    margin: 0 0 25px;
}

.timer-boxes {
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: center;
    width: 30%;
    margin: 0 auto;
}

.time-box_namber {
    width: 61px;
    height: 61px;
    align-items: center;
    justify-content: center;
    background-image: url(https://cdn.shopify.com/s/files/1/0649/7271/8230/files/timerbg.png?v=1766151384);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 7px;
    text-align: center;
    font-size: 34px;
    color: #fff;
    line-height: normal;
    font-weight: bold;
    letter-spacing: 0;
    display: flex;
}

.time-box p{
    font-size: 12px;
    text-align: center;
    padding: 5px 0;
    color: #fff;
    letter-spacing: 0;
}

@media screen and (max-width: 767px) {

}
</style>
<section class="christmas-holiday-timer-section">
  <div class="christmas-holiday-timer-container">
    <div class="christmas-holiday-timer-flex">

      <!-- LEFT IMAGES -->
      <div class="christmas-holiday-timer-left-box-images">
        <div class="christmas-holiday-timer-left-img">
          {% if section.settings.main-christmas-holiday-timer-left-box-img != blank %}
            <img
              class="christmas-holiday-timer-left-box-img"
              src="{{ section.settings.main-christmas-holiday-timer-left-box-img | img_url: 'master' }}"
              alt=""
            >
          {% endif %}

          {% if section.settings.main-christmas-holiday-timer-left-box-img-moblie != blank %}
            <img
              class="christmas-holiday-timer-left-box-img-moblie"
              src="{{ section.settings.main-christmas-holiday-timer-left-box-img-moblie | img_url: 'master' }}"
              alt=""
            >
          {% endif %}
        </div>
      </div>

      <!-- TIMER -->
      <div class="christmas-holiday-timer-right">
        <div class="christmas-holiday-timer-right-text-box">
        <h2 class="christmas-holiday-timer-right_timer-heading">{{ section.settings.main-christmas-holiday-timer-right_timer-heading }}</h2>
            </div>
        <div class="timer-boxes">
          <div class="time-box">
            <div class="time-box_namber">
            <span id="ch-days">00</span>
            </div>
            <p>{{ section.settings.main-christmas-holiday-timer-right_timer-heading-day }}</p>
        </div>
          <div class="time-box">
            <div class="time-box_namber">
            <span id="ch-hours">00</span>
            </div>
            <p>{{ section.settings.main-christmas-holiday-timer-right_timer-heading-hours }}</p>
          </div>
          <div class="time-box">
            <div class="time-box_namber">
            <span id="ch-mins">00</span>
            </div>
            <p>{{ section.settings.main-christmas-holiday-timer-right_timer-heading-mins }}</p>
          </div>
          <div class="time-box">
            <div class="time-box_namber">
            <span id="ch-secs">00</span>
            </div>
            <p>{{ section.settings.main-christmas-holiday-timer-right_timer-heading-secs }}</p>
          </div>
        </div>
      </div>

      <div class="christmas-holiday-timer-right-box-images">
        <div class="christmas-holiday-timer-right-img">
          {% if section.settings.main-christmas-holiday-timer-right-box-img != blank %}
            <img
              class="christmas-holiday-timer-right-box-img"
              src="{{ section.settings.main-christmas-holiday-timer-right-box-img | img_url: 'master' }}"
              alt=""
            >
          {% endif %}

          {% if section.settings.main-christmas-holiday-timer-right-box-img-moblie != blank %}
            <img
              class="christmas-holiday-timer-right-box-img-moblie"
              src="{{ section.settings.main-christmas-holiday-timer-right-box-img-moblie | img_url: 'master' }}"
              alt=""
            >
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>
<script>
  function christmasHolidayTimer() {
    // END DATE (change if needed)
    var endDate = new Date("Dec 31, 2025 23:59:59").getTime();

    setInterval(function () {
      var now = new Date().getTime();
      var distance = endDate - now;

      if (distance < 0) return;

      var days = Math.floor(distance / (1000 * 60 * 60 * 24));
      var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      var mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      var secs = Math.floor((distance % (1000 * 60)) / 1000);

      document.getElementById("ch-days").innerHTML = String(days).padStart(2, '0');
      document.getElementById("ch-hours").innerHTML = String(hours).padStart(2, '0');
      document.getElementById("ch-mins").innerHTML = String(mins).padStart(2, '0');
      document.getElementById("ch-secs").innerHTML = String(secs).padStart(2, '0');
    }, 1000);
  }

  christmasHolidayTimer();
</script>

{% schema %}
