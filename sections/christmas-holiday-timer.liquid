    },
    {
    "type": "image_picker",
    "id": "main-christmas-holiday-timer-left-box-img-moblie",
    "label": "Main Holidat Timer Images Moblie"
    },
    {
    "type": "text",
    "id": "main-christmas-holiday-timer-right_timer-heading",
    "label": "Main TiTle"
    },
    {
    "type": "text",
    "id": "main-christmas-holiday-timer-right_timer-heading-day",
    "label": "Main TiTle Day"
    },
    {
    "type": "text",
    "id": "main-christmas-holiday-timer-right_timer-heading-hours",
    "label": "Main TiTle Hours"
    },
    {
    "type": "text",
    "id": "main-christmas-holiday-timer-right_timer-heading-mins",
    "label": "Main TiTle Mins"
    },
    {
    "type": "text",
    "id": "main-christmas-holiday-timer-right_timer-heading-secs",
    "label": "Main TiTle Secs"
    },
    {
    "type": "image_picker",
    "id": "main-christmas-holiday-timer-right-box-img",
    "label": "Main Holidat Timer Images"
    },
    {
    "type": "image_picker",
    "id": "main-christmas-holiday-timer-right-box-img-moblie",
    "label": "Main Holidat Timer Images Moblie"
    },
  ],
  "presets": [
