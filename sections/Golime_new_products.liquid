<style>
    .G_P_Section {
    padding: 40px 0;
}

.G_P_Containe {
    max-width: 1260px;
    margin: 0 auto;
    width: 100%;
}

.G_P_Content {
    text-align: center;
}

.G_P_Title {
    margin: 0;
    font-size: 40px;
    color: #3c4043;
    font-weight: 700;
}

.G_P_Flex {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
}

.G_P_Flex {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    text-align: center;
    gap: 14px;
}

.G_P_Box {
    width: 32%;
    background: #fff;
    border-radius: 24px;
    padding: 28px 20px;
    transition: all .3s ease-in-out;
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 8px;
}

.G_P_Images {
    width: 204px;
    height: 204px;
}

.G_P_Img {
    width: 100%;
    height: 100%;
}

.G_P_Box_content {
    text-decoration: none;
}

.G_P_Box_Title {
    margin: 0;
    font-size: 22px;
    color: #454545;
    font-weight: 700;
}


.G_P_price {
    color: #70bc0e;
    font-size: 20px;
    letter-spacing: 0;
    line-height: 1.2;
    font-weight: 500;
}

.G_P_Compare_price {
    color: #454545;
    font-size: 20px;
    margin-left: 4px;
    text-decoration: line-through;
    font-weight: 600;
}
</style>

<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<section class="G_P_Section">
  <div class="G_P_Containe">
    <div class="G_P_Content">
      <h2 class="G_P_Title">{{ section.settings['mian-G_P_Title'] }}</h2>
    </div>
    <div class="G_P_Flex">
      {% for block in section.blocks %}
        {% assign products_product = block.settings.product_list %}
        {% assign product_form_id = 'quick-add-' | append: section_id | append: product.id %}
        {% if products_product != blank %}
          {% for products in products_product %}
            <div class="G_P_Box">
              <a href="{{ products.url }}" class="G_P_Images">
                <img src="{{ products.featured_image |img_url:'master' }}" alt="{{ products.title }}" class="G_P_Img">
              </a>
              <a href="{{ products.url }}" class="G_P_Box_content">
                <h3 class="G_P_Box_Title">{{ products.title }}</h3>
              </a>
              <div class="G_P_price_Content">
                <span class="G_P_price">{{ products.price | money }}</span>
                {% if products.compare_at_price > products.price %}
                  <span class="G_P_Compare_price">{{ products.compare_at_price | money }}</span>
                {% endif %}
              </div>
              <div class="G_P_Buy_Button">
                {%- render 'new-buy-buttons',
                  block: block,
                  product: products,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: true
                -%}
              </div>
              <a class="G_P_button">
                <span class="G_P_button_title">
                    {{ block.settings.main-G_P_button_title }}
                </span>
                <i class="fa-solid fa-chevron-right right"></i>
              </a>
            </div>
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Golime New Products",
  "settings": [
    {
    "type": "text",
    "id": "mian-G_P_Title",
    "label": "Title"
    }
  ],
  "blocks": [
    {
    "type": "Products",
    "name": "Products",
    "settings": [
        {
        "type": "product_list",
        "id": "product_list",
        "label": "Select Products"
        },
        {
        "type": "text",
        "id": "main-G_P_button_title",
        "label": "Button Title"
        }
    ]
    }
  ],
  "presets": [
    {
    "name": "Golime New Products"
    }
  ]
}
{% endschema %}
