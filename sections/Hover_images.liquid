<style>
  .Hover_images_text_section {
    padding-top: 100px;
    padding-bottom: 80px;
}

.Hover_images_text_content_title_para {
    text-align: center;
    padding-bottom: 25px;
}

.Hover_images_text_content_title_para p {
    font-size: 15px;
    letter-spacing: 0.6px;
    text-transform: capitalize;
    color: #7e7e7e;
    padding-top: 4px;
}

.Hover_images_text_content_title {
    margin: 0;
    font-size: 30px;
    text-transform: uppercase;
    font-weight: 400;
    color: #000;
}

.Hover_images_text_boxs_Flex {
    display: flex;
    justify-content: space-between;
}

.Hover_images_text_box_block {
    width: 25%;
}

.Hover_images_text_main_box {
    position: relative;
    background: #f3f3f3;
    transition: all .5s ease-in-out;
    overflow: hidden;
}

.Hover_images_text_Images_box {
    position: relative;
    height: 0;
    padding-bottom: 135%;
}

.Hover_images_text_images_box-img {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
    transition: all .5s ease-in-out;
    object-fit: cover;
}

.Hover_images_text_content_box_block {
    background: #f3f3f3;
    padding: 26px 25px;
    position: absolute;
    bottom: -100%;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    right: auto;
    transition: all .5s ease-in-out;
}

.Hover_images_text_content_box_description_block p {
    margin: 0;
    line-height: 28px;
    font-size: 16px;
    letter-spacing: 1px;
    color: #7e7e7e;
    padding-bottom: 25px;
}

.Hover_images_text_box_block:hover .Hover_images_text_images_box-img {
    top: -100%;
}
.Hover_images_text_box_block:hover .Hover_images_text_content_box_block {
    bottom: 0;
    right: auto;
}
</style>
<section class="Hover_images_text_section">
  <div class="Hover_images_text_container">
  <div class="Hover_images_text_content_title_para">
    <h2 class="Hover_images_text_content_title">{{ section.settings.main-Hover_images_text_title }}</h2>
    <p>{{ section.settings.main-Hover_images_text_para }}</p>
  </div>
  <div class="Hover_images_text_boxs_Flex">
    {% for block in section.blocks %}
      <div class="Hover_images_text_box_block">
        <div class="Hover_images_text_main_box">
          <div class="Hover_images_text_Images_box">
            {% if block.settings.main-Hover_images_text_images_box-img !=blank %}
            <img src="{{ block.settings.main-Hover_images_text_images_box-img |img_url:'master' }}" alt="" class="Hover_images_text_images_box-img">
            {% endif %}
          </div>
          <div class="Hover_images_text_content_box_block">
            <div class="Hover_images_text_content_box_description_block">
              {{ block.settings.main_Hover_images_text_content_box_description }}
            </div>
            
          </div>
        </div>
      </div>
      {% endfor %}
  </div>
  </div>
</section>
{% schema %}
{
  "name": "Hover Imaegs Boxs",
  "settings": [
    {
    "type": "text",
    "id": "main-Hover_images_text_title",
    "label": "Hover Images Text Title"
    },
    {
    "type": "richtext",
    "id": "main-Hover_images_text_para",
    "label": "Hover Images Text Description"
    }
  ],
  "blocks": [
    {
    "type": "Images_Box",
    "name": "Images Box",
    "settings": [
      {
      "type": "image_picker",
      "id": "main-Hover_images_text_images_box-img",
      "label": "Hover Images Text Block Images"
      },
      {
      "type": "textarea",
      "id": "main_Hover_images_text_content_box_description",
      "label": "Hover Images Text Block Description"
      }
    ]
    }
  ],
  "presets": [
    {
    "name": "Hover Imaegs Boxs"
    }
  ]
}
{% endschema %}
