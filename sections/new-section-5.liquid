{%- comment -%}
  VANTA Shoe Wall
  Add as: sections/vanta-shoe-wall.liquid
{%- endcomment -%}

<div class="vsw" id="vsw-{{ section.id }}" style="--bg:{{ section.settings.bg }};--wall:{{ section.settings.wall }};--ink:{{ section.settings.text }};--glow:{{ section.settings.glow }};--cols:{{ section.settings.columns }};--pill:{{ section.settings.button_bg }}">
  <div class="vsw__intro">
    {%- if section.settings.eyebrow != blank -%}
      <small>{{ section.settings.eyebrow }}</small>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="vsw__cones" aria-hidden="true">
    {%- for i in (1..section.settings.columns) -%}
      <i></i>
    {%- endfor -%}
  </div>

  <div class="vsw__wall">
    {%- for block in section.blocks -%}
      <div class="vsw__slot"
        tabindex="0"
        role="button"
        aria-label="{{ block.settings.name | escape }}"
        data-name="{{ block.settings.name | escape }}"
        data-price="{{ block.settings.price | escape }}"
        data-info="{{ block.settings.description | escape }}"
        data-link="{{ block.settings.link }}"
        {{ block.shopify_attributes }}>

        <div class="vsw__shoe">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', alt: block.settings.name }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        <div class="vsw__shelf"></div>
      </div>
    {%- endfor -%}
  </div>

  <div class="vsw__hero" aria-live="polite">
    <button class="vsw__back" type="button">
      ← {{ section.settings.back_label }}
    </button>

    <div class="vsw__big">
      <h3 class="vsw__hname"></h3>
      <div class="vsw__hshoe"></div>
      <div class="vsw__hshelf"></div>
    </div>

    <div class="vsw__side">
      <h4 class="vsw__sname"></h4>
      <p class="vsw__sinfo"></p>
      <p class="vsw__sprice"></p>
      <a class="vsw__btn" href="#">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</div>

<style>
  #vsw-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.min_height }}vh;
    overflow: hidden;
    color: var(--ink);
    background: radial-gradient(120% 80% at 50% 0%, var(--wall) 0%, var(--bg) 70%);
  }

  #vsw-{{ section.id }} * {
    box-sizing: border-box;
  }

  #vsw-{{ section.id }} .vsw__intro {
    position: relative;
    z-index: 4;
    padding: 24px 4vw 0;
  }

  #vsw-{{ section.id }} .vsw__intro small {
    display: block;
    font-size: 10px;
    letter-spacing: .2em;
    opacity: .6;
  }

  #vsw-{{ section.id }} .vsw__intro h2 {
    margin: 6px 0 0;
    font-weight: 400;
    font-size: 22px;
  }

  #vsw-{{ section.id }} .vsw__cones {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    padding: 0 4vw;
    pointer-events: none;
    z-index: 1;
  }

  #vsw-{{ section.id }} .vsw__cones i {
    background: linear-gradient(
      180deg,
      rgba(255,255,255,.16),
      rgba(255,255,255,.04) 55%,
      transparent 85%
    );
    clip-path: polygon(38% 0, 62% 0, 92% 100%, 8% 100%);
    margin: 0 2%;
  }

  #vsw-{{ section.id }} .vsw__wall {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 4vh 2vw;
    padding: 7vh 4vw 8vh;
    transition: filter .6s, opacity .6s;
  }

  #vsw-{{ section.id }}.is-focus .vsw__wall {
    filter: blur(14px);
    opacity: .25;
    pointer-events: none;
  }

  #vsw-{{ section.id }} .vsw__slot {
    position: relative;
    cursor: pointer;
    aspect-ratio: 2 / 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  #vsw-{{ section.id }} .vsw__shoe {
    width: 84%;
    transition: transform .45s cubic-bezier(.2,.7,.2,1);
    filter: drop-shadow(0 10px 8px rgba(0,0,0,.55));
  }

  #vsw-{{ section.id }} .vsw__shoe img,
  #vsw-{{ section.id }} .vsw__shoe svg {
    width: 100%;
    height: auto;
    display: block;
  }

  #vsw-{{ section.id }} .vsw__shelf {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -2px;
    height: 7px;
    border-radius: 3px;
    background: linear-gradient(
      180deg,
      rgba(255,255,255,.35),
      rgba(255,255,255,.08)
    );
    border: 1px solid rgba(255,255,255,.18);
    transition: box-shadow .4s, background .4s;
  }

  #vsw-{{ section.id }} .vsw__slot:hover .vsw__shoe,
  #vsw-{{ section.id }} .vsw__slot:focus-visible .vsw__shoe {
    transform: translateY(-6px) scale(1.04);
  }

  #vsw-{{ section.id }} .vsw__slot:hover .vsw__shelf,
  #vsw-{{ section.id }} .vsw__slot:focus-visible .vsw__shelf {
    background: var(--glow);
    border-color: var(--glow);
    box-shadow:
      0 6px 18px 2px var(--glow),
      0 0 40px 8px var(--glow);
  }

  #vsw-{{ section.id }} .vsw__hero {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: grid;
    grid-template-columns: 1fr 240px;
    align-items: center;
    padding: 60px 4vw 4vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity .5s;
  }

  #vsw-{{ section.id }}.is-focus .vsw__hero {
    opacity: 1;
    pointer-events: auto;
  }

  #vsw-{{ section.id }} .vsw__big {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #vsw-{{ section.id }} .vsw__hshoe {
    width: min(100%, 640px);
    transform: scale(.6) translateY(20px);
    transition: transform .7s cubic-bezier(.2,.8,.2,1);
    filter: drop-shadow(0 22px 16px rgba(0,0,0,.6));
  }

  #vsw-{{ section.id }}.is-focus .vsw__hshoe {
    transform: none;
  }

  #vsw-{{ section.id }} .vsw__hshoe img,
  #vsw-{{ section.id }} .vsw__hshoe svg {
    width: 100%;
    height: auto;
    display: block;
  }

  #vsw-{{ section.id }} .vsw__hshelf {
    width: min(86%, 560px);
    height: 12px;
    margin-top: -6px;
    border-radius: 5px;
    background: var(--glow);
    box-shadow:
      0 10px 30px 4px var(--glow),
      0 0 80px 18px var(--glow);
  }

  #vsw-{{ section.id }} .vsw__hname {
    position: absolute;
    left: 0;
    top: -30px;
    margin: 0;
    font-weight: 400;
    letter-spacing: .12em;
    font-size: 20px;
  }

  #vsw-{{ section.id }} .vsw__side {
    font-size: 12px;
    line-height: 1.8;
    opacity: .9;
  }

  #vsw-{{ section.id }} .vsw__sname {
    margin: 0 0 8px;
    font-weight: 500;
    letter-spacing: .14em;
    font-size: 13px;
  }

  #vsw-{{ section.id }} .vsw__side p {
    margin: 0 0 6px;
  }

  #vsw-{{ section.id }} .vsw__btn {
    display: inline-block;
    margin-top: 12px;
    background: var(--pill);
    color: #3d3a2c;
    border-radius: 6px;
    padding: 9px 16px;
    font-size: 12px;
    text-decoration: none;
  }

  #vsw-{{ section.id }} .vsw__back {
    position: absolute;
    left: 4vw;
    top: 14px;
    background: none;
    border: 1px solid rgba(255,255,255,.25);
    color: var(--ink);
    border-radius: 20px;
    padding: 5px 12px;
    font-size: 11px;
    cursor: pointer;
    z-index: 7;
  }

  @media(max-width: 700px) {
    #vsw-{{ section.id }} {
      --cols: 2;
    }

    #vsw-{{ section.id }} .vsw__hero {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 24px;
    }

    #vsw-{{ section.id }} .vsw__hname {
      position: static;
      margin-bottom: 14px;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('vsw-{{ section.id }}');
    if (!root) return;

    var q = function (s) {
      return root.querySelector(s);
    };

    function openShoe(slot) {
      q('.vsw__hname').textContent = slot.dataset.name;
      q('.vsw__sname').textContent = slot.dataset.name;
      q('.vsw__sinfo').textContent = slot.dataset.info;
      q('.vsw__sprice').textContent = slot.dataset.price;
      q('.vsw__hshoe').innerHTML =
        slot.querySelector('.vsw__shoe').innerHTML;

      q('.vsw__btn').setAttribute(
        'href',
        slot.dataset.link || '#'
      );

      root.classList.add('is-focus');
    }

    function closeShoe() {
      root.classList.remove('is-focus');
    }

    root.querySelectorAll('.vsw__slot').forEach(function (s) {
      s.addEventListener('click', function () {
        openShoe(s);
      });

      s.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openShoe(s);
        }
      });
    });

    q('.vsw__back').addEventListener('click', closeShoe);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeShoe();
    });
  })();
</script>

{% schema %}
{
  "name": "VANTA Shoe Wall",
  "tag": "section",
  "class": "section-vanta-shoe-wall",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "FOOTWEAR / SERIES 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Form, lit from within."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back button text",
      "default": "Back to wall"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Product button text",
      "default": "View product"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Section height (vh)",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#101215"
    },
    {
      "type": "color",
      "id": "wall",
      "label": "Wall light tone",
      "default": "#30353c"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Text",
      "default": "#e9e6df"
    },
    {
      "type": "color",
      "id": "glow",
      "label": "Hover glow",
      "default": "#ff8a1f"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button",
      "default": "#e8dfc9"
    }
  ],
  "blocks": [
    {
      "type": "shoe",
      "name": "Shoe",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Shoe image (transparent PNG)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "VECTOR 02"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$165"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "Series 01 · Sizes 7 – 13"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VANTA Shoe Wall",
      "blocks": [
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" },
        { "type": "shoe" }
      ]
    }
  ]
}
{% endschema %}